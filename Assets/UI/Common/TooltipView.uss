.tooltip-root {
    position: absolute;
    left: 0;
    top: 0;
    max-width: 260px;
    background-color: rgba(12, 14, 20, 0.92);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 6px 10px;
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.tooltip-root--visible {
    display: flex;
    opacity: 1;
}

.tooltip-label {
    font-size: 12px;
    color: rgb(235, 235, 240);
    white-space: normal;
}
