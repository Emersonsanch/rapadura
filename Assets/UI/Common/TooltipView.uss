/* Item / skill tooltip in the Rapadura theme (palette from Common/RapaduraTheme.uss). Opaque so
   the text never mixes with the slot grid underneath. */
.tooltip-root {
    position: absolute;
    left: 0;
    top: 0;
    max-width: 300px;
    background-color: rgb(40, 23, 13);
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--rap-caramel);
    padding: 8px 12px;
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.tooltip-root--visible {
    display: flex;
    opacity: 1;
}

.tooltip-label {
    font-size: 13px;
    color: var(--rap-cream);
    white-space: normal;
}

.tooltip-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    white-space: normal;
    margin-bottom: 1px;
}

.tooltip-subtitle {
    font-size: 12px;
    -unity-font-style: italic;
    color: var(--rap-cream-dim);
    white-space: normal;
    margin-bottom: 4px;
}

.tooltip-stats {
    font-size: 13px;
    color: rgb(190, 222, 130);
    white-space: normal;
    margin-bottom: 4px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(244, 196, 88, 0.3);
}

.tooltip-description {
    font-size: 12px;
    color: var(--rap-cream-dim);
    white-space: normal;
}
