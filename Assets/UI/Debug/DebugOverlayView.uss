.debug-overlay-root {
    position: absolute;
    right: 12px;
    top: 12px;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 4px;
    padding: 6px 10px;
}

.debug-overlay-label {
    font-size: 12px;
    color: rgb(120, 255, 120);
    -unity-font-style: bold;
}
