/* Quest log (Missões). Palette, window panel, heading and the Fechar / Acompanhar buttons come
   from Common/RapaduraTheme.uss (rap-theme on the root); list items and objective rows are
   created in code by QuestLogController and themed on their own classes here. */

.quest-log-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(20, 10, 4, 0.86);
    display: none;
}

.quest-log-window {
    width: 82%;
    min-width: 560px;
    max-width: 1100px;
    height: 82%;
    min-height: 380px;
    background-color: var(--rap-brown-deep);
    padding: 16px 20px;
}

.quest-log-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.quest-log-title {
    flex-grow: 1;
    font-size: 28px;
}

.quest-log-close-button {
    min-width: 96px;
    height: 44px;
    margin: 0;
    font-size: 16px;
}

.quest-log-tabs {
    flex-direction: row;
    margin-bottom: 10px;
    border-bottom-width: 2px;
    border-bottom-color: var(--rap-panel-border);
}

.quest-log-tab {
    min-width: 140px;
    min-height: 44px;
    margin: 0 8px 0 0;
    font-size: 15px;
    color: var(--rap-cream-dim);
    background-color: rgba(86, 50, 26, 0.6);
    border-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.quest-log-tab:hover {
    color: var(--rap-cream);
    background-color: var(--rap-brown-light);
}

.quest-log-tab:focus {
    color: var(--rap-cream);
    border-width: 2px;
    border-bottom-width: 0;
    border-color: var(--rap-focus);
}

.quest-log-tab--selected {
    color: rgb(60, 30, 8);
    -unity-font-style: bold;
    background-color: var(--rap-gold);
}

.quest-log-tab--selected:hover {
    color: rgb(60, 30, 8);
    background-color: var(--rap-gold-light);
}

.quest-log-body {
    flex-grow: 1;
    flex-direction: row;
}

.quest-list-scroll {
    width: 38%;
    min-width: 220px;
    margin-right: 14px;
}

.quest-list-empty-label {
    font-size: 14px;
    color: var(--rap-cream-dim);
    white-space: normal;
    margin: 10px 4px;
}

.quest-list-item {
    flex-direction: column;
    align-items: flex-start;
    min-height: 56px;
    margin: 0 0 6px 0;
    padding: 8px 12px;
    background-color: var(--rap-brown);
    border-width: 1px;
    border-color: rgba(226, 158, 70, 0.4);
    border-left-width: 5px;
    border-radius: 8px;
    -unity-text-align: middle-left;
}

.quest-list-item:hover {
    background-color: var(--rap-brown-light);
}

.quest-list-item:focus {
    border-color: var(--rap-focus);
}

.quest-list-item--main {
    border-left-color: var(--rap-gold);
}

.quest-list-item--side {
    border-left-color: rgb(110, 176, 220);
}

.quest-list-item--daily {
    border-left-color: rgb(150, 196, 90);
}

.quest-list-item--selected {
    background-color: rgba(196, 122, 44, 0.55);
    border-top-color: var(--rap-gold);
    border-right-color: var(--rap-gold);
    border-bottom-color: var(--rap-gold);
}

.quest-list-item--completed {
    opacity: 0.7;
}

.quest-list-item-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--rap-cream);
    white-space: normal;
}

.quest-list-item-subtitle {
    font-size: 12px;
    color: var(--rap-cream-dim);
    margin-top: 2px;
}

.quest-list-item-tracked {
    font-size: 12px;
    color: var(--rap-gold-light);
    margin-top: 2px;
}

.quest-detail-scroll {
    flex-grow: 1;
    padding: 4px 8px;
    background-color: var(--rap-brown-night);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(150, 96, 48, 0.6);
}

.quest-detail {
    padding: 8px 6px;
}

.quest-detail-title-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.quest-detail-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    margin-right: 10px;
    white-space: normal;
}

.quest-detail-type {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(60, 30, 8);
    background-color: var(--rap-gold);
    padding: 2px 8px;
    border-radius: 8px;
}

.quest-detail-description {
    font-size: 15px;
    color: var(--rap-cream);
    white-space: normal;
    margin-top: 8px;
}

.quest-detail-section {
    margin-top: 14px;
}

.quest-detail-section-header {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--rap-gold);
    margin-bottom: 6px;
}

.quest-detail-journal {
    font-size: 14px;
    -unity-font-style: italic;
    color: var(--rap-cream-dim);
    white-space: normal;
    padding-left: 10px;
    border-left-width: 3px;
    border-left-color: var(--rap-caramel);
}

.quest-objective-row {
    margin-bottom: 8px;
}

.quest-objective-header {
    flex-direction: row;
    align-items: center;
}

.quest-objective-check {
    width: 10px;
    height: 10px;
    margin-right: 8px;
    flex-shrink: 0;
    border-width: 2px;
    border-color: var(--rap-cream-dim);
    border-radius: 2px;
}

.quest-objective-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 14px;
    color: var(--rap-cream);
    white-space: normal;
}

.quest-objective-progress {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    margin-left: 8px;
}

.quest-objective-bar-track {
    height: 6px;
    margin: 4px 0 0 18px;
    background-color: rgba(86, 50, 26, 0.9);
    border-radius: 3px;
    overflow: hidden;
}

.quest-objective-bar-fill {
    height: 100%;
    background-color: var(--rap-caramel-light);
    border-radius: 3px;
}

.quest-objective-row--complete .quest-objective-check {
    border-color: rgb(170, 210, 110);
    background-color: var(--rap-cane-green);
}

.quest-objective-row--complete .quest-objective-text {
    color: var(--rap-cream-dim);
}

.quest-objective-row--complete .quest-objective-progress {
    color: rgb(190, 226, 130);
}

.quest-objective-row--complete .quest-objective-bar-fill {
    background-color: rgb(150, 196, 90);
}

.quest-detail-rewards {
    font-size: 15px;
    color: var(--rap-gold-light);
    white-space: normal;
}

.quest-detail-track-button {
    margin: 16px 0 0 0;
    align-self: flex-start;
    min-width: 180px;
    font-size: 17px;
}

/* Already tracked: quieter brown button (no longer the call to action). */
.quest-detail-track-button--tracking {
    color: var(--rap-gold-light);
    background-color: var(--rap-brown);
    border-color: var(--rap-caramel);
    border-bottom-color: rgb(52, 28, 12);
}
