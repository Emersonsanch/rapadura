.quest-tracker-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

/* Right edge, below the HUD's Skills/Menu buttons (top: 32px) so it never covers them. */
.quest-tracker-card {
    position: absolute;
    right: 24px;
    top: 130px;
    width: 260px;
    padding: 8px 12px;
    /* UI Toolkit blends in linear space: 0.72 (and 0.9) read washed out over Desert sand / Mountain snow.
       Rapadura theme (Common/RapaduraTheme.uss): brown-sugar card, caramel frame, gold title. */
    background-color: rgba(46, 27, 16, 0.96);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(150, 96, 48, 0.8);
    border-left-width: 4px;
    border-left-color: var(--rap-gold);
    /* Height cap: on a 20:9 phone (panel ~1433x645) the touch HUD's Dupla button (DuoStrike.uss: bottom 268px, 92px
       tall) tops out at 645 - 360 = 285px, right under this card; 130 + 143 + 12 gap = 285. One line for the title and
       each objective (ellipsis), at most 3 rows plus a "+N" line (QuestTrackerController): ~120px. Nothing inside
       shrinks (flex-shrink 0, else the rows got squashed onto each other); overflow: hidden clips the bottom instead,
       the last resort under a large accessibility font scale. */
    max-height: 143px;
    overflow: hidden;
    display: none;
}

.quest-tracker-card--pulse {
    background-color: rgba(128, 78, 40, 0.96);
}

.quest-tracker-title {
    flex-shrink: 0;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    margin-bottom: 4px;
}

.quest-tracker-objectives {
    flex-shrink: 0;
}

.quest-tracker-objective {
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 2px;
}

.quest-tracker-objective-text {
    flex-grow: 1;
    flex-shrink: 1;
    /* The theme's 4px label margin + padding made each 12px row ~29px tall, so a 3rd row pushed "+N" out of the cap. */
    margin: 0;
    padding: 0;
    font-size: 12px;
    color: var(--rap-cream);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.quest-tracker-objective-progress {
    padding: 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    margin: 0 0 0 6px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.quest-tracker-more {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-font-style: italic;
    color: var(--rap-cream-dim);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.quest-tracker-objective--complete .quest-tracker-objective-text {
    color: var(--rap-cream-dim);
}

.quest-tracker-objective--complete .quest-tracker-objective-progress {
    color: rgb(190, 226, 130);
}

.quest-tracker-toast {
    position: absolute;
    top: 18%;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(74, 36, 12);
    text-shadow: 2px 3px 0px rgba(36, 16, 6, 0.8);
    display: none;
}
