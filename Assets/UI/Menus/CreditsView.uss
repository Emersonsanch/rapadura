/* Credits. Palette, panel, heading and the Voltar button come from Common/RapaduraTheme.uss. */

.credits-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--rap-brown-night); /* opaque: the title / map is behind */
}

.credits-panel {
    width: 90%;
    max-width: 560px;
    max-height: 90%;
    background-color: var(--rap-brown-deep);
    padding: 18px;
    align-items: stretch;
}

.credits-title {
    font-size: 34px;
    -unity-text-align: middle-center;
}

.credits-version {
    font-size: 13px;
    -unity-text-align: middle-center;
    color: var(--rap-cream-dim);
    margin-bottom: 12px;
}

.credits-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 160px;
}

.credits-content {
    padding: 4px 8px;
}

.credits-section {
    margin-bottom: 18px;
    align-items: center;
}

.credits-section-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--rap-gold);
    margin-bottom: 6px;
}

.credits-line {
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--rap-cream);
    margin-bottom: 4px;
}

/* Touch-first: 48px tall target, full width of the panel. */
.credits-back-button {
    height: 48px;
    margin: 12px 0 0 0;
    font-size: 18px;
}
