/* Title screen. Palette, logo and button styles come from Common/RapaduraTheme.uss (imported first
   in MainMenuView.uxml); this sheet only lays out the illustrated backdrop and the menu column.
   TitleScreenDecor paints the sky gradient, drifts the clouds and plays the entrance. */

.main-menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: rgb(46, 27, 16); /* opaque: the world map renders behind the front-end */
}

/* ---------------------------------------------------------------- backdrop */

.main-menu-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.main-menu-sky {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(176, 92, 60); /* until the gradient texture is applied */
    -unity-background-scale-mode: stretch-to-fill;
}

.main-menu-sun-glow {
    position: absolute;
    left: 56%;
    /* 6% (was 14%): the sun sits above the far hill's slope instead of sinking behind it. */
    top: 6%;
    width: 520px;
    height: 520px;
    border-radius: 260px;
    background-color: rgba(255, 214, 130, 0.16);
    align-items: center;
    justify-content: center;
}

.main-menu-sun-halo {
    width: 340px;
    height: 340px;
    border-radius: 170px;
    background-color: rgba(255, 220, 140, 0.28);
    align-items: center;
    justify-content: center;
}

.main-menu-sun {
    width: 200px;
    height: 200px;
    border-radius: 100px;
    background-color: rgb(255, 222, 140);
    border-width: 4px;
    border-color: rgba(255, 244, 200, 0.8);
}

.main-menu-cloud {
    position: absolute;
    height: 40px;
    border-radius: 20px;
    background-color: rgba(255, 228, 200, 0.42);
}

.main-menu-cloud--a {
    top: 9%;
    width: 300px;
}

.main-menu-cloud--b {
    top: 19%;
    width: 220px;
    height: 30px;
    border-radius: 15px;
    background-color: rgba(255, 210, 180, 0.32);
}

.main-menu-cloud--c {
    top: 30%;
    width: 360px;
    height: 46px;
    border-radius: 23px;
    background-color: rgba(250, 196, 150, 0.3);
}

/* Hills are circles (px size, radius = half the size) stretched into soft ellipses with `scale`:
   UI Toolkit has no elliptical border-radius, and a percentage-sized box with 50% radii only gets
   its corners rounded, which read as a flat rectangular block (playtest: the right-hand hill
   covered the sun). Positions are px from the bottom so the engenho always stands on its hill.
   Panel space is ~1306x735 at 16:9 and ~1461x657 at 20:9 (1200x800 reference, match 0.5). */
.main-menu-hill {
    position: absolute;
}

/* Hazy hill on the right horizon; the sun sets onto its left slope, never behind a block. */
.main-menu-hill--far {
    right: -320px;
    bottom: -110px;
    width: 560px;
    height: 560px;
    border-radius: 280px;
    scale: 2.2 0.7;
    background-color: rgb(140, 78, 72);
}

/* Brown-sugar hill carrying the engenho (left). Visual top ~435px above the screen bottom. */
.main-menu-hill--mid {
    left: -180px;
    bottom: -40px;
    width: 500px;
    height: 500px;
    border-radius: 250px;
    scale: 2 0.9;
    background-color: rgb(112, 60, 38);
}

/* On the mid hill's crest (its surface is ~431px up at the engenho's centre). */
.main-menu-engenho {
    position: absolute;
    left: 100px;
    bottom: 424px;
    width: 120px;
    height: 110px;
}

.main-menu-engenho-house {
    position: absolute;
    left: 10px;
    bottom: 0;
    width: 96px;
    height: 52px;
    background-color: rgb(64, 32, 22);
}

.main-menu-engenho-roof {
    position: absolute;
    left: 24px;
    bottom: 22px;
    width: 68px;
    height: 68px;
    rotate: 45deg;
    background-color: rgb(64, 32, 22);
}

.main-menu-engenho-chimney {
    position: absolute;
    left: 86px;
    bottom: 30px;
    width: 14px;
    height: 80px;
    background-color: rgb(58, 28, 20);
}

/* The canavial (sugar-cane field) in front: a long, gentle rise centred on the screen. */
.main-menu-hill--near {
    left: 50%;
    margin-left: -300px;
    bottom: -260px;
    width: 600px;
    height: 600px;
    border-radius: 300px;
    scale: 2.8 0.55;
    background-color: rgb(88, 98, 40);
}

.main-menu-cane {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 11%;
    background-color: rgb(52, 58, 24);
    border-top-width: 3px;
    border-top-color: rgb(120, 136, 54);
}

/* ---------------------------------------------------------------- menu column */

/* 500px: the 80px logo ("Rapadura" ~390px wide with its outline) fits inside the plaque with room
   to spare; at 400px / 96px it spilled ~130px over the border (playtest). */
.main-menu-panel {
    width: 500px;
    max-width: 94%;
    align-items: center;
    padding: 26px 30px 18px 30px;
    border-radius: 24px;
    background-color: rgba(36, 20, 10, 0.62);
    border-width: 2px;
    border-color: rgba(226, 158, 70, 0.55);
}

.main-menu-logo {
    align-items: center;
    margin-bottom: 22px;
    transition-property: opacity, translate;
    transition-duration: 0.7s, 0.7s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.main-menu-title {
    margin: 0;
    padding: 0;
    font-size: 80px;
    letter-spacing: 2px;
    white-space: nowrap;
    flex-shrink: 0;
}

/* Caramel bar under the logo, like the paper band around a block of rapadura. */
.main-menu-logo-ribbon {
    width: 300px;
    height: 10px;
    margin-top: 2px;
    border-radius: 5px;
    background-color: rgb(196, 122, 44);
    border-width: 2px;
    border-color: rgb(244, 196, 88);
}

.main-menu-tagline {
    margin-top: 10px;
    font-size: 17px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    color: rgb(255, 236, 200);
    text-shadow: 1px 2px 0px rgba(30, 14, 4, 0.8);
    white-space: normal;
}

.main-menu-button-list {
    width: 100%;
    max-width: 380px;
    flex-direction: column;
    transition-property: translate;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-cubic;
}

.main-menu-button {
    width: 100%;
    /* Hover/focus/press feedback (first five) stays quick; opacity is the staggered entrance
       (TitleScreenDecor sets each button's transition-delay in this same order). */
    transition-property: background-color, border-color, scale, translate, color, opacity;
    transition-duration: 0.12s, 0.12s, 0.12s, 0.12s, 0.12s, 0.45s;
    transition-timing-function: ease-out, ease-out, ease-out, ease-out, ease-out, ease-out;
}

/* ---------------------------------------------------------------- entrance */

.main-menu--entering .main-menu-logo {
    opacity: 0;
    translate: 0 -28px;
}

.main-menu--entering .main-menu-button-list {
    translate: 0 26px;
}

.main-menu--entering .main-menu-button {
    opacity: 0;
}
