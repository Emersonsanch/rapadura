<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="/Assets/UI/Common/RapaduraTheme.uss" />
    <Style src="/Assets/UI/Menus/SaveLoadMenuView.uss" />
    <ui:VisualElement name="save-load-menu-root" class="save-load-menu-root rap-theme">
        <ui:VisualElement name="save-load-menu-panel" class="save-load-menu-panel rap-panel">
            <ui:VisualElement name="save-load-header" class="save-load-header">
                <ui:Label name="save-load-title-label" text="Salvar Jogo" class="save-load-title rap-heading" />
                <ui:VisualElement class="save-load-header-spacer" picking-mode="Ignore" />
                <ui:Button name="close-button" text="Fechar" focusable="true" class="save-load-close-button loc rap-button" view-data-key="ui.saveload.close" />
            </ui:VisualElement>

            <ui:ScrollView name="slot-scroll" class="save-load-scroll">
                <ui:VisualElement name="slot-list-container" class="save-slot-list" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
