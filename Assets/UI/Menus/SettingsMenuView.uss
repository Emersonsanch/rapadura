/* Settings. Palette, panel, heading and the Fechar / footer buttons come from
   Common/RapaduraTheme.uss (rap-theme on the root); tabs, fields and the rebind rows (created in
   code by SettingsMenuController) are themed on their own classes here. */

.settings-menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 10, 4, 0.9);
}

.settings-menu-panel {
    /* 640: the Controles tab's action column ("Mover para a esquerda") was clipped at 560. */
    width: 640px;
    max-width: 94%;
    max-height: 96%;
    min-height: 380px;
    background-color: var(--rap-brown-deep);
    padding: 16px 18px;
}

.settings-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.settings-title {
    font-size: 26px;
}

.settings-header-spacer {
    flex-grow: 1;
}

.settings-close-button {
    height: 44px;
    margin: 0;
    padding: 0 16px;
    font-size: 16px;
}

.settings-tab-bar {
    flex-direction: row;
    margin-bottom: 12px;
    border-bottom-width: 2px;
    border-bottom-color: var(--rap-panel-border);
}

.settings-tab-button {
    flex-grow: 1;
    height: 38px;
    margin: 0 2px;
    font-size: 14px;
    background-color: transparent;
    border-width: 0;
    border-radius: 8px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    color: var(--rap-cream-dim);
}

.settings-tab-button:hover {
    color: var(--rap-cream);
    background-color: rgba(128, 78, 40, 0.5);
}

/* Focus (keyboard/gamepad) is a soft tint, never an underline: the underline belongs to the active
   tab only, and a focus underline left on Gráficos read as a second active tab (playtest). */
.settings-tab-button:focus {
    color: var(--rap-cream);
    background-color: rgba(196, 122, 44, 0.4);
    border-bottom-width: 0;
}

.settings-tab-button--selected,
.settings-tab-button--selected:focus {
    color: var(--rap-gold-light);
    -unity-font-style: bold;
    background-color: rgba(128, 78, 40, 0.7);
    border-bottom-width: 3px;
    border-bottom-color: var(--rap-gold);
}

.settings-content {
    flex-grow: 1;
}

.settings-panel {
    flex-direction: column;
    display: none;
}

.settings-field {
    margin-bottom: 10px;
}

/* The default runtime theme draws field labels near-black, which was invisible on this dark panel
   (Qualidade / Tela Cheia / Volume... measured at ~rgb(27,27,27) on rgb(21,24,30)). */
.settings-field > .unity-base-field__label,
.settings-field .unity-toggle__text {
    color: var(--rap-cream);
    font-size: 14px;
    min-width: 170px;
    -unity-text-align: middle-left;
}

/* Toggle rows keep one checkbox column: a longer label ("Vibração (só no celular/tablet)") wraps
   inside the 170px label column instead of pushing its checkbox out of line with the others. */
.settings-field.unity-toggle > .unity-base-field__label {
    width: 170px;
    max-width: 170px;
    flex-shrink: 0;
    white-space: normal;
}

.settings-field.unity-toggle {
    align-items: center;
}

.settings-field .unity-base-slider__dragger {
    background-color: var(--rap-gold);
    border-color: rgb(110, 58, 16);
}

.settings-field .unity-base-slider__tracker {
    background-color: var(--rap-brown-night);
    border-color: var(--rap-caramel);
}

.settings-field .unity-toggle__checkmark {
    background-color: var(--rap-brown-night);
    border-color: var(--rap-caramel-light);
}

.settings-field .unity-base-popup-field__input {
    background-color: var(--rap-brown);
    border-color: var(--rap-caramel);
    color: var(--rap-cream);
}

.settings-field:focus .unity-base-popup-field__input,
.settings-field:focus .unity-toggle__checkmark {
    border-color: var(--rap-focus);
}

.settings-placeholder-label {
    font-size: 14px;
    color: var(--rap-cream);
    white-space: normal;
    margin-bottom: 8px;
}

.settings-placeholder-note {
    font-size: 12px;
    color: var(--rap-cream-dim);
    white-space: normal;
}

/* ---- Controles (rebind) ---- */

.settings-rebind-list {
    max-height: 250px;
    margin-bottom: 6px;
}

.settings-rebind-row {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    margin-bottom: 2px;
}

.settings-rebind-row--header {
    border-bottom-width: 1px;
    border-bottom-color: rgba(244, 196, 88, 0.3);
    margin-bottom: 4px;
}

.settings-rebind-action-label {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 13px;
    color: var(--rap-cream);
    -unity-text-align: middle-left;
}

.settings-rebind-column-label {
    width: 140px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--rap-gold);
    -unity-text-align: middle-center;
}

.settings-rebind-button,
.settings-rebind-reset-button {
    height: 32px;
    color: var(--rap-cream);
    background-color: var(--rap-brown);
    border-width: 1px;
    border-color: rgba(226, 158, 70, 0.6);
    border-bottom-color: rgb(52, 28, 12);
    border-radius: 8px;
}

.settings-rebind-button:hover,
.settings-rebind-reset-button:hover {
    background-color: var(--rap-brown-light);
}

.settings-rebind-button:focus,
.settings-rebind-reset-button:focus {
    border-width: 2px;
    border-color: var(--rap-focus);
}

.settings-rebind-button {
    width: 140px;
    margin: 0 2px;
    font-size: 13px;
}

.settings-rebind-button--overridden {
    color: var(--rap-gold-light);
    -unity-font-style: bold;
}

/* Listening for a key: a different fill AND border, not just a hue change. */
.settings-rebind-button--listening {
    color: rgb(60, 30, 8);
    background-color: var(--rap-gold);
    border-color: rgb(255, 250, 220);
}

.settings-rebind-button:disabled {
    opacity: 0.4;
}

.settings-rebind-reset-button {
    width: 80px;
    font-size: 12px;
}

.settings-rebind-reset-spacer {
    width: 84px;
}

.settings-rebind-status {
    min-height: 18px;
    font-size: 13px;
    color: var(--rap-cream-dim);
    white-space: normal;
    margin-bottom: 6px;
}

.settings-rebind-status--warning {
    color: rgb(255, 176, 90);
}

.settings-rebind-footer {
    flex-direction: row;
    align-items: center;
}

.settings-rebind-footer-button {
    padding: 4px 14px;
    margin: 0;
    font-size: 15px;
    /* 44px: minimum comfortable touch target (Cancelar / Restaurar tudo are tapped on phones too). */
    height: auto;
    min-height: 44px;
}

/* "Cancelar" only shows while a rebind is listening (SettingsMenuController.UpdateRebindModeVisuals):
   accent-coloured so it reads as the way out, next to the "press a key/button" status. */
.settings-rebind-cancel-button {
    min-width: 120px;
    color: rgb(255, 250, 240);
    background-color: var(--rap-clay-red);
    border-color: rgb(244, 160, 120);
}
