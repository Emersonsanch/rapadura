.settings-menu-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 7, 10, 0.85);
}

.settings-menu-panel {
    width: 560px;
    min-height: 380px;
    background-color: rgba(18, 20, 27, 0.98);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 16px;
}

.settings-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.settings-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 240, 245);
}

.settings-header-spacer {
    flex-grow: 1;
}

.settings-close-button {
    padding: 4px 14px;
}

.settings-tab-bar {
    flex-direction: row;
    margin-bottom: 12px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.settings-tab-button {
    flex-grow: 1;
    height: 34px;
    background-color: transparent;
    border-width: 0;
    color: rgb(190, 190, 198);
}

.settings-tab-button:hover {
    color: rgb(230, 230, 235);
}

.settings-tab-button:focus {
    border-bottom-width: 3px;
    border-bottom-color: rgb(90, 170, 255);
}

.settings-tab-button--selected {
    color: rgb(255, 210, 90);
    border-bottom-width: 3px;
    border-bottom-color: rgb(255, 210, 90);
}

.settings-content {
    flex-grow: 1;
}

.settings-panel {
    flex-direction: column;
    display: none;
}

.settings-field {
    margin-bottom: 10px;
}

.settings-placeholder-label {
    font-size: 14px;
    color: rgb(220, 220, 225);
    white-space: normal;
    margin-bottom: 8px;
}

.settings-placeholder-note {
    font-size: 11px;
    color: rgb(150, 150, 160);
    white-space: normal;
}
