.settings-menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 7, 10, 0.9);
}

.settings-menu-panel {
    /* 640: the Controles tab's action column ("Mover para a esquerda") was clipped at 560. */
    width: 640px;
    max-width: 94%;
    max-height: 96%;
    min-height: 380px;
    background-color: rgb(18, 20, 27);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 16px;
}

.settings-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.settings-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 240, 245);
}

.settings-header-spacer {
    flex-grow: 1;
}

.settings-close-button {
    padding: 4px 14px;
}

.settings-tab-bar {
    flex-direction: row;
    margin-bottom: 12px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.settings-tab-button {
    flex-grow: 1;
    height: 34px;
    background-color: transparent;
    border-width: 0;
    color: rgb(190, 190, 198);
}

.settings-tab-button:hover {
    color: rgb(230, 230, 235);
}

.settings-tab-button:focus {
    border-bottom-width: 3px;
    border-bottom-color: rgb(90, 170, 255);
}

.settings-tab-button--selected {
    color: rgb(255, 210, 90);
    border-bottom-width: 3px;
    border-bottom-color: rgb(255, 210, 90);
}

.settings-content {
    flex-grow: 1;
}

.settings-panel {
    flex-direction: column;
    display: none;
}

.settings-field {
    margin-bottom: 10px;
}

/* The default runtime theme draws field labels near-black, which was invisible on this dark panel
   (Qualidade / Tela Cheia / Volume... measured at ~rgb(27,27,27) on rgb(21,24,30)). */
.settings-field > .unity-base-field__label,
.settings-field .unity-toggle__text {
    color: rgb(220, 220, 228);
    font-size: 14px;
    min-width: 170px;
    -unity-text-align: middle-left;
}

.settings-field .unity-base-slider__dragger {
    background-color: rgb(255, 210, 90);
}

.settings-placeholder-label {
    font-size: 14px;
    color: rgb(220, 220, 225);
    white-space: normal;
    margin-bottom: 8px;
}

.settings-placeholder-note {
    font-size: 11px;
    color: rgb(150, 150, 160);
    white-space: normal;
}

/* ---- Controles (rebind) ---- */

.settings-rebind-list {
    max-height: 250px;
    margin-bottom: 6px;
}

.settings-rebind-row {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    margin-bottom: 2px;
}

.settings-rebind-row--header {
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    margin-bottom: 4px;
}

.settings-rebind-action-label {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 13px;
    color: rgb(220, 220, 225);
    -unity-text-align: middle-left;
}

.settings-rebind-column-label {
    width: 140px;
    font-size: 12px;
    color: rgb(150, 150, 160);
    -unity-text-align: middle-center;
}

.settings-rebind-button {
    width: 140px;
    height: 30px;
    margin: 0 2px;
    font-size: 13px;
}

.settings-rebind-button--overridden {
    color: rgb(255, 210, 90);
}

.settings-rebind-button--listening {
    color: rgb(90, 170, 255);
    border-color: rgb(90, 170, 255);
}

.settings-rebind-button:disabled {
    opacity: 0.4;
}

.settings-rebind-reset-button {
    width: 80px;
    height: 30px;
    font-size: 11px;
}

.settings-rebind-reset-spacer {
    width: 84px;
}

.settings-rebind-status {
    min-height: 18px;
    font-size: 12px;
    color: rgb(190, 190, 198);
    white-space: normal;
    margin-bottom: 6px;
}

.settings-rebind-status--warning {
    color: rgb(255, 170, 60);
}

.settings-rebind-footer {
    flex-direction: row;
    align-items: center;
}

.settings-rebind-footer-button {
    padding: 4px 14px;
    /* 44px: minimum comfortable touch target (Cancelar / Restaurar tudo are tapped on phones too). */
    min-height: 44px;
}

/* "Cancelar" only shows while a rebind is listening (SettingsMenuController.UpdateRebindModeVisuals):
   accent-coloured so it reads as the way out, next to the "press a key/button" status. */
.settings-rebind-cancel-button {
    min-width: 120px;
    color: rgb(255, 255, 255);
    background-color: rgb(150, 60, 50);
    border-color: rgb(255, 170, 140);
}
