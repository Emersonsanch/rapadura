.pause-menu-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 7, 10, 0.75);
}

.pause-menu-panel {
    width: 320px;
    align-items: center;
    padding: 20px;
    background-color: rgba(20, 22, 30, 0.97);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.08);
}

.pause-menu-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(240, 240, 245);
    margin-bottom: 18px;
}

.pause-menu-button-list {
    width: 100%;
    flex-direction: column;
}

.pause-menu-button {
    width: 100%;
    height: 40px;
    margin-bottom: 8px;
    font-size: 14px;
    background-color: rgba(35, 38, 48, 0.9);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    color: rgb(230, 230, 235);
}

.pause-menu-button:hover {
    background-color: rgba(55, 59, 72, 0.95);
    border-color: rgba(255, 255, 255, 0.25);
}

.pause-menu-button:focus {
    border-color: rgb(90, 170, 255);
    border-width: 3px;
}
