/* Pause menu. Palette, panel, heading and buttons come from Common/RapaduraTheme.uss (imported
   first in the UXML; rap-theme on the root): this sheet only sizes and lays them out. */

.pause-menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 10, 4, 0.88);
}

.pause-menu-panel {
    width: 340px;
    align-items: center;
    padding: 22px 24px 14px 24px;
    background-color: var(--rap-brown-deep);
}

.pause-menu-title {
    font-size: 30px;
    margin-bottom: 18px;
}

.pause-menu-button-list {
    width: 100%;
    flex-direction: column;
}

.pause-menu-button {
    width: 100%;
    /* min-height (not height) so the label can grow with the accessibility font scale. */
    height: auto;
    min-height: 48px;
    white-space: normal;
    margin-bottom: 8px;
    font-size: 17px;
}
