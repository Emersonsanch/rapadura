/* Save / load slots. Palette, panel, heading and the Fechar button come from
   Common/RapaduraTheme.uss (rap-theme on the root); the per-slot buttons are created in code by
   SaveLoadMenuController, so their themed look is spelled out here on their own classes. */

.save-load-menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 10, 4, 0.9);
}

.save-load-menu-panel {
    width: 520px;
    max-height: 460px;
    background-color: var(--rap-brown-deep);
    padding: 18px;
}

.save-load-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.save-load-title {
    font-size: 26px;
}

.save-load-header-spacer {
    flex-grow: 1;
}

.save-load-close-button {
    height: 44px;
    margin: 0;
    padding: 0 16px;
    font-size: 16px;
}

.save-load-scroll {
    flex-grow: 1;
}

.save-slot-list {
    flex-direction: column;
}

.save-slot-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin-bottom: 8px;
    background-color: rgba(86, 50, 26, 0.6);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(226, 158, 70, 0.45);
}

.save-slot-title-label {
    width: 90px;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
}

.save-slot-status-label {
    flex-grow: 1;
    font-size: 13px;
    color: var(--rap-cream-dim);
    white-space: normal;
}

.save-slot-primary-button,
.save-slot-delete-button {
    height: 36px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--rap-cream);
    background-color: var(--rap-brown);
    border-width: 2px;
    border-radius: 10px;
    border-color: var(--rap-caramel);
    border-bottom-color: rgb(52, 28, 12);
}

.save-slot-primary-button {
    width: 120px;
    margin-right: 6px;
    background-color: var(--rap-caramel);
    border-color: var(--rap-gold);
    border-bottom-color: rgb(110, 58, 16);
}

.save-slot-delete-button {
    width: 84px;
    background-color: rgb(110, 40, 24);
    border-color: rgb(200, 110, 80);
    border-bottom-color: rgb(60, 20, 10);
}

.save-slot-primary-button:hover,
.save-slot-delete-button:hover {
    border-color: var(--rap-gold-light);
}

.save-slot-primary-button:focus,
.save-slot-delete-button:focus {
    border-color: var(--rap-focus);
    border-width: 3px;
}

.save-slot-primary-button:disabled,
.save-slot-delete-button:disabled {
    opacity: 0.4;
}
