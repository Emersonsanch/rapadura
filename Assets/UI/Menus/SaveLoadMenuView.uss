.save-load-menu-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 7, 10, 0.85);
}

.save-load-menu-panel {
    width: 480px;
    max-height: 420px;
    background-color: rgba(18, 20, 27, 0.98);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 16px;
}

.save-load-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.save-load-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 240, 245);
}

.save-load-header-spacer {
    flex-grow: 1;
}

.save-load-close-button {
    padding: 4px 14px;
}

.save-load-scroll {
    flex-grow: 1;
}

.save-slot-list {
    flex-direction: column;
}

.save-slot-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin-bottom: 8px;
    background-color: rgba(30, 32, 40, 0.9);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.save-slot-title-label {
    width: 90px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(230, 230, 235);
}

.save-slot-status-label {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(160, 160, 170);
}

.save-slot-primary-button {
    width: 120px;
    height: 30px;
    margin-right: 6px;
}

.save-slot-delete-button {
    width: 80px;
    height: 30px;
}

.save-slot-primary-button:focus,
.save-slot-delete-button:focus {
    border-color: rgb(90, 170, 255);
    border-width: 3px;
}

.save-slot-primary-button:disabled,
.save-slot-delete-button:disabled {
    opacity: 0.4;
}
