/* Skill tree. Rapadura theme (Common/RapaduraTheme.uss, imported first in the UXML): rap-theme on
   the root gives the palette, rap-heading / rap-chip / rap-button the title, points and buttons.
   Nodes and connectors are created in code by SkillTreeUIController and themed on their classes. */

.skill-tree-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-grow: 1;
    flex-direction: column;
    /* Near-opaque: in linear colour space 0.94 still let the world (and its bright grass) bleed
       through behind the node canvas. */
    background-color: var(--rap-brown-night);
}

.skill-tree-header {
    /* flex-shrink 0: the scroll view's 900px canvas squeezed the header to ~36px on a 657px-tall
       phone panel, clipping the Fechar button off the top. */
    flex-shrink: 0;
    min-height: 56px;
    flex-direction: row;
    align-items: center;
    padding: 8px 16px;
    background-color: var(--rap-brown-deep);
    border-bottom-width: 2px;
    border-bottom-color: var(--rap-panel-border);
}

.skill-tree-title {
    font-size: 26px;
    margin-right: 12px;
}

.skill-tree-description {
    font-size: 13px;
    color: var(--rap-cream-dim);
    flex-shrink: 1;
    white-space: normal;
}

.skill-tree-header-spacer {
    flex-grow: 1;
}

.skill-points-label {
    font-size: 15px;
    color: var(--rap-gold-light);
    -unity-font-style: bold;
    margin: 0 16px 0 0;
    padding: 4px 12px;
}

.skill-tree-close-button {
    height: 44px;
    margin: 0;
    padding: 0 16px;
    min-width: 96px;
    font-size: 16px;
}

.skill-tree-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.skill-tree-canvas {
    position: relative;
    /* Breathing room so top-row nodes don't touch the header and the left column isn't flush to the screen edge. */
    margin: 24px 0 0 48px;
    min-width: 1200px;
    min-height: 900px;
}

.connector-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.node-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.skill-node {
    position: absolute;
    width: 84px;
    height: 84px;
    border-radius: 42px;
    border-width: 3px;
    align-items: center;
    justify-content: center;
    background-color: var(--rap-brown);
}

.skill-node-icon {
    width: 48px;
    height: 48px;
}

.skill-node-level-label {
    position: absolute;
    bottom: -20px;
    font-size: 12px;
    color: var(--rap-cream);
    -unity-font-style: bold;
    text-shadow: 1px 1px 1px rgba(20, 8, 2, 0.95);
}

/* Each state differs in border colour AND fill/opacity, so it never relies on hue alone. */
.skill-node--locked {
    border-color: rgb(110, 84, 64);
    background-color: var(--rap-brown-deep);
    opacity: 0.6;
}

.skill-node--available {
    border-color: var(--rap-caramel-light);
}

.skill-node--learned {
    border-color: rgb(170, 210, 110);
    background-color: rgb(70, 72, 30);
}

.skill-node--maxlevel {
    border-color: var(--rap-gold);
    background-color: rgb(128, 78, 40);
}

.skill-node--selected {
    border-color: var(--rap-cream);
    border-width: 4px;
}

.skill-detail-panel {
    flex-shrink: 0;
    padding: 12px 16px;
    background-color: var(--rap-brown-deep);
    border-top-width: 2px;
    border-top-color: var(--rap-panel-border);
    min-height: 90px;
}

.skill-detail-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
}

.skill-detail-description {
    font-size: 13px;
    color: var(--rap-cream);
    white-space: normal;
    margin-top: 4px;
}

.skill-detail-stats {
    font-size: 13px;
    color: rgb(190, 222, 130);
    margin-top: 4px;
}

.skill-detail-action-button {
    margin: 8px 0 0 0;
    width: 180px;
    font-size: 17px;
}
