.skill-tree-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgba(12, 14, 20, 0.94);
}

.skill-tree-header {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    background-color: rgba(20, 22, 30, 0.95);
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.skill-tree-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 240, 245);
    margin-right: 12px;
}

.skill-tree-description {
    font-size: 12px;
    color: rgb(160, 160, 170);
}

.skill-tree-header-spacer {
    flex-grow: 1;
}

.skill-points-label {
    font-size: 14px;
    color: rgb(255, 210, 90);
    -unity-font-style: bold;
    margin-right: 16px;
}

.skill-tree-close-button {
    padding: 4px 14px;
}

.skill-tree-scroll {
    flex-grow: 1;
}

.skill-tree-canvas {
    position: relative;
    min-width: 1200px;
    min-height: 900px;
}

.connector-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.node-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.skill-node {
    position: absolute;
    width: 84px;
    height: 84px;
    border-radius: 42px;
    border-width: 3px;
    align-items: center;
    justify-content: center;
    background-color: rgb(30, 32, 40);
}

.skill-node-icon {
    width: 48px;
    height: 48px;
}

.skill-node-level-label {
    position: absolute;
    bottom: -18px;
    font-size: 11px;
    color: rgb(220, 220, 220);
}

.skill-node--locked {
    border-color: rgb(70, 70, 78);
    opacity: 0.55;
}

.skill-node--available {
    border-color: rgb(90, 170, 255);
}

.skill-node--learned {
    border-color: rgb(90, 220, 130);
}

.skill-node--maxlevel {
    border-color: rgb(255, 195, 60);
}

.skill-node--selected {
    border-color: rgb(255, 255, 255);
}

.skill-detail-panel {
    padding: 14px 16px;
    background-color: rgba(20, 22, 30, 0.97);
    border-top-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.08);
    min-height: 90px;
}

.skill-detail-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(240, 240, 245);
}

.skill-detail-description {
    font-size: 12px;
    color: rgb(180, 180, 190);
    white-space: normal;
    margin-top: 4px;
}

.skill-detail-stats {
    font-size: 11px;
    color: rgb(150, 200, 255);
    margin-top: 4px;
}

.skill-detail-action-button {
    margin-top: 8px;
    width: 160px;
}
