/* World map HUD (WorldMapHudController). Same look as HudView.uss: Rapadura theme (brown-sugar
   panels with caramel borders and cream text, palette from Common/RapaduraTheme.uss imported first),
   near-opaque so it reads over sand and snow,
   68px round touch buttons in a flex row top-right so accessibility text scaling only widens them.
   Budget at 2400x1080 (panel ~1461x657 with the 1200x800 reference): the top bar is ~700px wide
   at scale 1 (left), the button cluster ~380px (right), leaving room for the notch safe area. */

.wm-hud-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.wm-labels-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

/* ---- Top bar: hero | region + victories | weather + clock ---- */
.wm-top-bar {
    position: absolute;
    left: 24px;
    top: 24px;
    max-width: 62%;
    flex-direction: row;
    align-items: center;
    padding: 8px 14px;
    background-color: rgba(46, 27, 16, 0.9);
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--rap-panel-border);
}

.wm-top-block {
    flex-direction: column;
    justify-content: center;
    flex-shrink: 1;
}

.wm-top-separator {
    width: 1px;
    height: 34px;
    margin: 0 14px;
    background-color: rgba(244, 196, 88, 0.35);
}

.wm-hero-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--rap-cream);
}

.wm-hero-level {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--rap-gold);
}

.wm-region-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
}

.wm-victories {
    font-size: 12px;
    color: var(--rap-cream-dim);
    white-space: normal;
}

.wm-boss-button {
    display: none;
    align-self: flex-start;
    min-height: 44px;
    margin: 6px 0 0 0;
    padding: 4px 16px;
    border-radius: 22px;
    border-width: 2px;
    border-color: var(--rap-gold);
    border-bottom-color: rgb(70, 20, 10);
    border-bottom-width: 3px;
    background-color: rgb(140, 44, 24);
    color: var(--rap-cream);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.wm-boss-button:hover {
    background-color: rgb(170, 60, 32);
}

.wm-boss-button:focus {
    border-color: var(--rap-focus);
}

.wm-boss-button:active {
    background-color: rgb(110, 32, 16);
}

.wm-boss-button--visible {
    display: flex;
}

.wm-action-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.wm-action-row > .wm-boss-button {
    margin-left: 8px;
}

.wm-explore-button {
    align-self: flex-start;
    min-height: 44px;
    margin: 6px 0 0 0;
    padding: 4px 18px;
    border-radius: 22px;
    border-width: 2px;
    border-color: var(--rap-gold);
    border-bottom-color: rgb(110, 58, 16);
    border-bottom-width: 3px;
    background-color: var(--rap-caramel);
    color: rgb(255, 252, 240);
    text-shadow: 1px 1px 0px rgba(60, 26, 6, 0.8);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.wm-explore-button:hover {
    background-color: var(--rap-caramel-light);
}

.wm-explore-button:focus {
    border-color: var(--rap-focus);
}

.wm-explore-button:active {
    background-color: rgb(150, 86, 30);
}

.wm-explore-button:disabled {
    opacity: 0.5;
}

.wm-weather-row {
    flex-direction: row;
    align-items: center;
}

.wm-weather-label {
    font-size: 13px;
    color: var(--rap-cream);
}

.wm-clock {
    font-size: 12px;
    color: var(--rap-cream-dim);
}

/* Weather icon: a small USS-drawn badge (no font glyph dependency), tinted per weather. */
.wm-weather-icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    border-radius: 7px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.5);
}

.wm-weather-icon--clear {
    background-color: rgb(255, 205, 70);
    border-color: rgb(255, 235, 150);
}

.wm-weather-icon--rain {
    background-color: rgb(80, 140, 230);
    border-color: rgb(160, 200, 255);
    border-top-left-radius: 1px;
}

.wm-weather-icon--fog {
    background-color: rgb(165, 170, 180);
    border-color: rgb(210, 214, 222);
    border-radius: 3px;
}

.wm-weather-icon--sandstorm {
    background-color: rgb(210, 150, 70);
    border-color: rgb(240, 200, 130);
    border-radius: 3px;
    rotate: 45deg;
}

.wm-weather-icon--snow {
    background-color: rgb(245, 248, 255);
    border-color: rgb(170, 200, 235);
}

/* ---- Top-right buttons (Missões / Mochila / Conquistas / Menu) ---- */
.wm-button-cluster {
    position: absolute;
    top: 32px;
    right: 32px;
    flex-direction: row;
    align-items: center;
}

.wm-menu-button {
    min-width: 68px;
    height: 68px;
    border-radius: 34px;
    margin: 0 0 0 22px;
    padding: 0 10px;
    font-size: 13px;
    white-space: nowrap;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: var(--rap-cream);
    background-color: rgba(46, 27, 16, 0.88);
    border-width: 2px;
    border-color: var(--rap-caramel-light);
    border-bottom-color: rgb(52, 28, 12);
    text-shadow: 1px 1px 2px rgba(20, 8, 2, 0.95);
}

.wm-menu-button--first {
    margin-left: 0;
}

.wm-menu-button:hover {
    background-color: rgba(86, 50, 26, 0.92);
    border-color: var(--rap-gold);
}

.wm-menu-button:focus {
    border-color: var(--rap-focus);
}

.wm-menu-button:active {
    background-color: rgba(196, 122, 44, 0.92);
    border-color: var(--rap-gold-light);
}

/* ---- Region labels (one per WorldMapRegionNode, positioned in code) ---- */
.wm-region-label {
    position: absolute;
    /* left/top is the node's projected point; anchor the label's bottom-center on it. */
    translate: -50% -100%;
    min-width: 96px;
    align-items: center;
    padding: 6px 12px;
    background-color: rgba(46, 27, 16, 0.88);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(226, 158, 70, 0.55);
}

/* Far regions (not current, travelable or the adjacent locked goal) collapse to a name chip so
   cards don't pile up; WorldMapHudController also nudges overlapping labels apart vertically. */
.wm-region-label--compact {
    min-width: 0;
    padding: 3px 8px;
    border-radius: 8px;
    opacity: 0.9;
}

.wm-region-label--compact .wm-region-label-name {
    font-size: 13px;
}

.wm-region-label--current {
    border-color: var(--rap-gold);
    background-color: rgba(86, 50, 26, 0.92);
}

.wm-region-label--travelable {
    border-color: rgb(170, 200, 110);
}

.wm-region-label--locked {
    background-color: rgba(28, 16, 10, 0.85);
    border-color: rgba(150, 120, 96, 0.55);
}

.wm-region-label-header {
    flex-direction: row;
    align-items: center;
}

.wm-region-label-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--rap-cream);
}

.wm-region-label--locked .wm-region-label-name {
    color: rgb(206, 186, 160);
}

.wm-region-label-status {
    font-size: 11px;
    color: var(--rap-cream-dim);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 220px;
}

.wm-region-label--current .wm-region-label-status {
    color: var(--rap-gold-light);
    -unity-font-style: bold;
}

/* Padlock drawn with two boxes (shackle + body). Hidden unless the region is locked. */
.wm-lock-icon {
    display: none;
    width: 14px;
    height: 16px;
    margin-right: 6px;
    align-items: center;
}

.wm-region-label--locked .wm-lock-icon {
    display: flex;
}

.wm-lock-shackle {
    width: 10px;
    height: 7px;
    border-width: 2px;
    border-bottom-width: 0;
    border-color: rgb(210, 190, 166);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

.wm-lock-body {
    width: 14px;
    height: 9px;
    border-radius: 2px;
    background-color: rgb(210, 190, 166);
}

/* Cleared marker: green badge with a check drawn by two borders of a rotated box (no glyph needed). */
.wm-cleared-icon {
    display: none;
    width: 16px;
    height: 16px;
    margin-right: 6px;
    border-radius: 8px;
    background-color: var(--rap-cane-green);
    align-items: center;
    justify-content: center;
}

.wm-region-label--cleared .wm-cleared-icon {
    display: flex;
}

.wm-cleared-check {
    width: 5px;
    height: 9px;
    margin-bottom: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: rgb(245, 250, 240);
    rotate: 45deg;
}

.wm-region-label--cleared {
    border-color: rgb(140, 176, 80);
}

.wm-region-label--current.wm-region-label--cleared {
    border-color: var(--rap-gold);
}

/* ---- Mochila summary (modal) ---- */
.wm-backpack-overlay {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 10, 4, 0.86);
}

.wm-backpack-panel {
    width: 380px;
    padding: 20px;
    background-color: var(--rap-brown-deep);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--rap-panel-border);
}

.wm-backpack-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(74, 36, 12);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.wm-backpack-hero {
    font-size: 13px;
    color: var(--rap-gold);
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.wm-backpack-lines {
    flex-direction: column;
    margin-bottom: 10px;
}

.wm-backpack-line {
    font-size: 14px;
    color: var(--rap-cream);
    white-space: normal;
    margin-bottom: 4px;
}

.wm-backpack-hint {
    font-size: 12px;
    color: var(--rap-cream-dim);
    white-space: normal;
    margin-bottom: 14px;
}

/* Look from .rap-button / .rap-button--primary (RapaduraTheme.uss). */
.wm-backpack-close {
    min-height: 48px;
    margin: 0;
}

/* ---- Map add-on buttons injected into .wm-action-row (VillageHubButton / RegionNpcTalkButton) ----
   They carry .wm-explore-button for size and shape; these rules give each its own colour. */
.wm-village-button {
    background-color: var(--rap-brown);
    border-color: var(--rap-caramel-light);
    border-bottom-color: rgb(52, 28, 12);
}

.wm-village-button:hover {
    background-color: var(--rap-brown-light);
}

.wm-village-button:active {
    background-color: rgb(70, 40, 20);
}

.wm-talk-button {
    background-color: rgb(52, 92, 104);
    border-color: rgb(170, 214, 210);
    border-bottom-color: rgb(20, 40, 46);
}

.wm-talk-button:hover {
    background-color: rgb(66, 114, 126);
}

.wm-talk-button:active {
    background-color: rgb(36, 70, 80);
}

.wm-village-button:focus,
.wm-talk-button:focus {
    border-color: var(--rap-focus);
}

/* ---- Vila da Vó Zefa hub (VillageHubButton, built in code on top of the Mochila overlay) ---- */
.wm-village-panel {
    width: 500px;
    padding: 22px 24px;
}

.wm-village-section {
    margin-top: 8px;
    margin-bottom: 8px;
    padding-bottom: 4px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    border-bottom-width: 1px;
    border-bottom-color: rgba(244, 196, 88, 0.35);
}

.wm-village-option {
    width: 49%;
    height: auto;
    min-height: 48px;
    margin: 0 0 8px 0;
    padding: 4px 10px;
    font-size: 15px;
    white-space: normal;
}
