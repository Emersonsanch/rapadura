.crafting-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    display: none;
}

.crafting-window {
    width: 70%;
    min-width: 520px;
    max-width: 960px;
    height: 70%;
    min-height: 380px;
    background-color: rgba(12, 14, 20, 0.92);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    padding: 16px 20px;
}

.crafting-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.crafting-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 210, 90);
    flex-grow: 1;
}

.crafting-close-button {
    width: 36px;
    height: 36px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: rgb(235, 235, 240);
}

.crafting-close-button:hover {
    background-color: rgba(255, 80, 80, 0.35);
}

.crafting-panels {
    flex-direction: row;
    flex-grow: 1;
}

.crafting-panel {
    flex-basis: 0;
    margin: 0 6px;
}

.crafting-panel--list {
    flex-grow: 2;
}

.crafting-panel--details {
    flex-grow: 3;
}

.crafting-panel-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(235, 235, 240);
    margin-bottom: 6px;
}

.crafting-scroll {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
}

.crafting-list {
    flex-direction: column;
    padding: 6px;
}

.crafting-empty {
    color: rgb(160, 160, 170);
    padding: 8px;
    display: none;
}

.crafting-recipe-button {
    margin: 3px 0;
    padding: 10px;
    min-height: 44px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: rgb(170, 170, 180);
    -unity-text-align: middle-left;
}

.crafting-recipe-button:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.crafting-recipe-button--craftable {
    color: rgb(150, 230, 150);
}

.crafting-recipe-button--selected {
    border-color: rgb(255, 210, 90);
    background-color: rgba(255, 210, 90, 0.14);
}

.crafting-recipe-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 220, 120);
}

.crafting-recipe-description {
    color: rgb(200, 200, 205);
    white-space: normal;
    margin-bottom: 10px;
}

.crafting-ingredient-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 8px;
    margin: 2px 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.05);
}

.crafting-ingredient-name {
    color: rgb(235, 235, 240);
}

.crafting-ingredient-count {
    -unity-font-style: bold;
}

.crafting-ingredient-row--ok .crafting-ingredient-count {
    color: rgb(130, 220, 130);
}

.crafting-ingredient-row--missing .crafting-ingredient-count {
    color: rgb(240, 110, 100);
}

.crafting-result {
    margin-top: 10px;
    color: rgb(235, 235, 240);
}

.crafting-block-reason {
    color: rgb(240, 150, 110);
    min-height: 18px;
}

.crafting-craft-button {
    height: 52px;
    margin-top: 6px;
    font-size: 17px;
    -unity-font-style: bold;
    background-color: rgba(70, 150, 80, 0.85);
    border-width: 1px;
    border-color: rgba(150, 230, 150, 0.5);
    border-radius: 8px;
    color: rgb(245, 245, 245);
}

.crafting-craft-button:hover {
    background-color: rgba(85, 175, 95, 0.95);
}

.crafting-craft-button:disabled {
    opacity: 0.4;
}

.crafting-feedback {
    min-height: 20px;
    margin-top: 6px;
    -unity-text-align: middle-center;
}

.crafting-feedback--success {
    color: rgb(150, 235, 150);
    -unity-font-style: bold;
}

.crafting-feedback--error {
    color: rgb(240, 110, 100);
}
