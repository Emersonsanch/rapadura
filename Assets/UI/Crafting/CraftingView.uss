/* Workbench (Criação). Palette, window panel, heading and the Criar / close buttons come from
   Common/RapaduraTheme.uss (rap-theme on the root); recipe and ingredient rows are created in
   code by CraftingUIController and themed on their own classes here. */

.crafting-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    display: none;
    /* Modal backdrop, matching the quest log / achievements windows. */
    background-color: rgba(20, 10, 4, 0.86);
}

.crafting-window {
    width: 70%;
    min-width: 520px;
    max-width: 960px;
    /* 80%: at 70% only two ingredient rows fit on a 20:9 phone before the list scrolled. */
    height: 80%;
    min-height: 380px;
    max-height: 92%;
    background-color: var(--rap-brown-deep);
    padding: 16px 20px;
}

.crafting-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.crafting-title {
    font-size: 26px;
    flex-grow: 1;
}

.crafting-close-button {
    /* 44px: same touch target as the inventory/shop close buttons. */
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
}

.crafting-close-button:hover {
    background-color: var(--rap-clay-red);
}

.crafting-panels {
    flex-direction: row;
    flex-grow: 1;
}

.crafting-panel {
    flex-basis: 0;
    margin: 0 6px;
}

.crafting-panel--list {
    flex-grow: 2;
}

.crafting-panel--details {
    flex-grow: 3;
}

.crafting-panel-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    margin-bottom: 6px;
}

.crafting-scroll {
    flex-grow: 1;
    background-color: var(--rap-brown-night);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(150, 96, 48, 0.6);
}

.crafting-list {
    flex-direction: column;
    padding: 6px;
}

.crafting-empty {
    color: var(--rap-cream-dim);
    padding: 8px;
    display: none;
}

.crafting-recipe-button {
    margin: 3px 0;
    padding: 10px;
    min-height: 44px;
    background-color: var(--rap-brown);
    border-width: 1px;
    border-color: rgba(226, 158, 70, 0.45);
    border-radius: 8px;
    color: var(--rap-cream-dim);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.crafting-recipe-button:hover {
    background-color: var(--rap-brown-light);
}

.crafting-recipe-button:focus {
    border-color: var(--rap-focus);
}

.crafting-recipe-button--craftable {
    color: rgb(196, 230, 140);
    -unity-font-style: bold;
}

.crafting-recipe-button--selected {
    border-width: 2px;
    border-color: var(--rap-gold);
    background-color: rgba(196, 122, 44, 0.5);
}

.crafting-recipe-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
}

.crafting-recipe-description {
    color: var(--rap-cream-dim);
    white-space: normal;
    margin-bottom: 10px;
}

.crafting-ingredient-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 8px;
    margin: 2px 0;
    border-radius: 6px;
    background-color: rgba(86, 50, 26, 0.6);
}

.crafting-ingredient-name {
    color: var(--rap-cream);
}

.crafting-ingredient-count {
    -unity-font-style: bold;
}

.crafting-ingredient-row--ok .crafting-ingredient-count {
    color: rgb(190, 226, 130);
}

.crafting-ingredient-row--missing .crafting-ingredient-count {
    color: rgb(240, 110, 100);
}

.crafting-result {
    margin-top: 10px;
    color: var(--rap-cream);
}

.crafting-block-reason {
    color: rgb(240, 150, 110);
    min-height: 18px;
}

.crafting-craft-button {
    height: 52px;
    margin: 6px 0 0 0;
    font-size: 19px;
}

.crafting-feedback {
    min-height: 20px;
    margin-top: 6px;
    -unity-text-align: middle-center;
}

.crafting-feedback--success {
    color: rgb(196, 230, 140);
    -unity-font-style: bold;
}

.crafting-feedback--error {
    color: rgb(240, 110, 100);
}
