<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="/Assets/UI/Common/RapaduraTheme.uss" />
    <Style src="/Assets/UI/Crafting/CraftingView.uss" />
    <ui:VisualElement name="crafting-root" class="crafting-root rap-theme">
        <ui:VisualElement name="crafting-window" class="crafting-window rap-panel">
            <ui:VisualElement name="crafting-header" class="crafting-header">
                <ui:Label name="crafting-title" text="Criação" class="crafting-title loc rap-heading" view-data-key="ui.crafting.title" />
                <ui:Button name="crafting-close-button" text="X" class="crafting-close-button rap-button" />
            </ui:VisualElement>
            <ui:VisualElement name="crafting-panels" class="crafting-panels">
                <ui:VisualElement class="crafting-panel crafting-panel--list">
                    <ui:Label text="Receitas" class="crafting-panel-title loc" view-data-key="ui.crafting.recipes" />
                    <ui:ScrollView name="crafting-recipe-scroll" class="crafting-scroll">
                        <ui:VisualElement name="crafting-recipe-list" class="crafting-list" />
                        <ui:Label name="crafting-empty" text="Nenhuma receita conhecida." class="crafting-empty loc" view-data-key="ui.crafting.empty" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement class="crafting-panel crafting-panel--details">
                    <ui:Label name="crafting-recipe-name" text="" class="crafting-recipe-name" />
                    <ui:Label name="crafting-recipe-description" text="" class="crafting-recipe-description" />
                    <ui:Label text="Materiais" class="crafting-panel-title loc" view-data-key="ui.crafting.materials" />
                    <ui:ScrollView name="crafting-ingredient-scroll" class="crafting-scroll">
                        <ui:VisualElement name="crafting-ingredient-list" class="crafting-list" />
                    </ui:ScrollView>
                    <ui:Label name="crafting-result" text="" class="crafting-result" />
                    <ui:Label name="crafting-block-reason" text="" class="crafting-block-reason" />
                    <ui:Button name="crafting-craft-button" text="Criar" focusable="true" class="crafting-craft-button loc rap-button rap-button--primary" view-data-key="ui.crafting.craft" />
                    <ui:Label name="crafting-feedback" text="" class="crafting-feedback" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
