/* Shop. Palette, window panel, heading, gold chip and close button come from
   Common/RapaduraTheme.uss (rap-theme on the root); the buy / sell rows are created in code by
   ShopUIController, so their themed look is spelled out on .shop-row-button here. */

.shop-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    display: none;
    /* Modal backdrop, matching the quest log / achievements windows. */
    background-color: rgba(20, 10, 4, 0.86);
}

.shop-window {
    width: 70%;
    min-width: 520px;
    max-width: 960px;
    height: 70%;
    min-height: 380px;
    max-height: 92%;
    background-color: var(--rap-brown-deep);
    padding: 16px 20px;
}

.shop-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.shop-name {
    font-size: 26px;
    flex-grow: 1;
}

.shop-currency {
    flex-direction: row;
    align-items: center;
    margin: 0 12px 0 0;
    padding: 4px 12px;
}

.shop-currency-label {
    color: var(--rap-cream);
    font-size: 15px;
    margin-right: 4px;
}

.shop-currency-amount {
    color: var(--rap-gold-light);
    font-size: 15px;
    -unity-font-style: bold;
}

.shop-close-button {
    /* 44px touch target (was 28px — hard to hit on a phone, and sat under the quest tracker card). */
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
}

.shop-close-button:hover {
    background-color: var(--rap-clay-red);
}

.shop-panels {
    flex-direction: row;
    flex-grow: 1;
}

.shop-panel {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 6px;
}

.shop-panel-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    margin-bottom: 6px;
}

.shop-scroll {
    flex-grow: 1;
    background-color: var(--rap-brown-night);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(150, 96, 48, 0.6);
}

.shop-list {
    flex-direction: column;
    padding: 6px;
}

.shop-row-button {
    margin: 3px 0;
    padding: 8px 10px;
    min-height: 44px;
    background-color: var(--rap-brown);
    border-width: 1px;
    border-color: rgba(226, 158, 70, 0.45);
    border-bottom-color: rgb(52, 28, 12);
    border-bottom-width: 2px;
    border-radius: 8px;
    color: var(--rap-cream);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.shop-row-button:hover {
    background-color: var(--rap-brown-light);
}

.shop-row-button:focus {
    border-color: var(--rap-focus);
    background-color: rgba(196, 122, 44, 0.45);
}

.shop-row-button:disabled {
    /* 0.6: at 0.4 unaffordable items (the whole catalog at 0 gold) were barely legible. */
    opacity: 0.6;
}
