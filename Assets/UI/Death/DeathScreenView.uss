.death-screen-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(30, 4, 4, 0.82);
    opacity: 0;
    display: none;
}

.death-screen-panel {
    min-width: 320px;
    max-width: 640px;
    width: 60%;
    padding: 24px 28px;
    align-items: center;
}

.death-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(230, 70, 60);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.death-message {
    font-size: 18px;
    color: rgb(225, 215, 205);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 28px;
}

/* First-death tutorial tip: same amber language as TutorialHintView.uss, inside the panel. */
.death-tip {
    width: 100%;
    max-width: 480px;
    padding: 10px 14px;
    margin-bottom: 18px;
    background-color: rgba(34, 22, 12, 0.95);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(240, 178, 70);
}

.death-tip-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 178, 70);
    white-space: normal;
    margin-bottom: 2px;
}

.death-tip-body {
    font-size: 16px;
    color: rgb(240, 230, 215);
    white-space: normal;
}

.death-button-list {
    width: 100%;
    max-width: 360px;
    flex-direction: column;
}

/* Touch-first: tall hit targets (>= 56px). */
.death-button {
    height: 56px;
    margin: 6px 0;
    font-size: 18px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: rgb(235, 235, 240);
}

.death-button:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.death-button:disabled {
    opacity: 0.4;
}

.death-button--primary {
    background-color: rgba(200, 60, 45, 0.85);
    border-color: rgba(255, 140, 120, 0.6);
    -unity-font-style: bold;
}

.death-button--primary:hover {
    background-color: rgba(225, 80, 60, 0.95);
}

.death-countdown {
    margin-top: 14px;
    font-size: 14px;
    color: rgb(180, 170, 165);
    -unity-text-align: middle-center;
}
