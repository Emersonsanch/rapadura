/* Death screen. Palette, panel and buttons come from Common/RapaduraTheme.uss (rap-theme on the
   root); this sheet keeps the dusky-red backdrop and the layout. */

.death-screen-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(40, 10, 4, 0.86);
    opacity: 0;
    display: none;
}

.death-screen-panel {
    min-width: 320px;
    max-width: 640px;
    width: 60%;
    padding: 24px 28px;
    align-items: center;
    background-color: rgba(46, 27, 16, 0.95);
    border-color: rgb(178, 72, 40);
}

.death-title {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(240, 104, 70);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(60, 14, 4);
    text-shadow: 2px 3px 0px rgba(36, 8, 2, 0.8);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.death-message {
    font-size: 18px;
    color: var(--rap-cream);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 28px;
}

/* First-death tutorial tip: same amber language as TutorialHintView.uss, inside the panel. */
.death-tip {
    width: 100%;
    max-width: 480px;
    padding: 10px 14px;
    margin-bottom: 18px;
    background-color: rgb(70, 40, 20);
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--rap-gold);
}

.death-tip-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--rap-gold);
    white-space: normal;
    margin-bottom: 2px;
}

.death-tip-body {
    font-size: 16px;
    color: var(--rap-cream);
    white-space: normal;
}

.death-button-list {
    width: 100%;
    max-width: 360px;
    flex-direction: column;
}

/* Touch-first: tall hit targets (>= 56px). */
.death-button {
    height: 56px;
    margin: 6px 0;
    font-size: 19px;
}

.death-countdown {
    margin-top: 14px;
    font-size: 15px;
    color: var(--rap-cream-dim);
    -unity-text-align: middle-center;
}
