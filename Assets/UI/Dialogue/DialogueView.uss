.dialogue-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: flex-end;
    align-items: center;
    display: none;
}

.dialogue-box {
    width: 70%;
    min-width: 420px;
    max-width: 900px;
    margin-bottom: 40px;
    background-color: rgba(12, 14, 20, 0.85);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    padding: 16px 20px;
}

.dialogue-speaker-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 210, 90);
    margin-bottom: 6px;
}

.dialogue-line-text {
    font-size: 15px;
    color: rgb(235, 235, 240);
    white-space: normal;
    margin-bottom: 12px;
}

.dialogue-choices-container {
    flex-direction: column;
}

.dialogue-choice-button {
    margin: 4px 0;
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: rgb(235, 235, 240);
    -unity-text-align: middle-left;
}

.dialogue-choice-button:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.dialogue-continue-button {
    align-self: flex-end;
    padding: 6px 16px;
    background-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    color: rgb(235, 235, 240);
    display: none;
}
