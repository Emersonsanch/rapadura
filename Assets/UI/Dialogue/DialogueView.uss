/* Dialogue box in the Rapadura theme (Common/RapaduraTheme.uss, imported first in DialogueView.uxml;
   rap-theme on the root, rap-panel on the box, rap-button on Continuar). Opaque enough to read over
   sand and snow; the speaker sits on a caramel name plate like a label on a block of rapadura. */

.dialogue-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: flex-end;
    align-items: center;
    display: none;
}

.dialogue-box {
    width: 70%;
    min-width: 420px;
    max-width: 900px;
    margin-bottom: 40px;
    background-color: rgba(46, 27, 16, 0.95);
    padding: 16px 20px;
}

.dialogue-speaker-name {
    align-self: flex-start;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 252, 240);
    background-color: var(--rap-caramel);
    border-width: 1px;
    border-color: var(--rap-gold);
    border-radius: 8px;
    padding: 2px 12px;
    margin-bottom: 8px;
    text-shadow: 1px 1px 0px rgba(60, 26, 6, 0.8);
}

.dialogue-line-text {
    font-size: 16px;
    color: var(--rap-cream);
    white-space: normal;
    margin-bottom: 12px;
}

.dialogue-choices-container {
    flex-direction: column;
}

.dialogue-choice-button {
    min-height: 44px;
    margin: 4px 0;
    padding: 8px 12px;
    font-size: 15px;
    white-space: normal;
    background-color: var(--rap-brown);
    border-width: 1px;
    border-left-width: 4px;
    border-color: rgba(226, 158, 70, 0.5);
    border-left-color: var(--rap-caramel);
    border-radius: 8px;
    color: var(--rap-cream);
    -unity-text-align: middle-left;
}

.dialogue-choice-button:hover {
    background-color: var(--rap-brown-light);
    border-left-color: var(--rap-gold);
}

.dialogue-choice-button:focus {
    border-color: var(--rap-focus);
    background-color: rgba(196, 122, 44, 0.6);
}

.dialogue-continue-button {
    align-self: flex-end;
    height: 44px;
    margin: 0;
    padding: 0 18px;
    font-size: 16px;
    display: none;
}
