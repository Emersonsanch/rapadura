.achievement-list-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.55);
    display: none;
}

.achievement-list-window {
    width: 82%;
    min-width: 360px;
    max-width: 900px;
    height: 82%;
    min-height: 380px;
    background-color: rgba(12, 14, 20, 0.95);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    padding: 16px 20px;
}

.achievement-list-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.achievement-list-header-texts {
    flex-grow: 1;
}

.achievement-list-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 210, 90);
}

.achievement-list-summary {
    font-size: 14px;
    color: rgb(170, 170, 180);
}

.achievement-list-close-button {
    min-width: 96px;
    min-height: 44px;
    font-size: 15px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: rgb(230, 230, 235);
}

.achievement-list-scroll {
    flex-grow: 1;
}

.achievement-list-empty-label {
    font-size: 15px;
    color: rgb(170, 170, 180);
    -unity-text-align: middle-center;
    margin-top: 24px;
    display: none;
}

.achievement-item {
    flex-direction: row;
    align-items: center;
    min-height: 72px;
    margin-bottom: 8px;
    padding: 10px 12px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    opacity: 0.75;
}

/* Gamepad/keyboard focus (FocusNavigator steps through the rows). */
.achievement-item:focus {
    border-color: rgb(255, 210, 90);
    opacity: 1;
}

.achievement-item--unlocked {
    opacity: 1;
    background-color: rgba(255, 210, 90, 0.1);
    border-color: rgba(255, 210, 90, 0.45);
}

.achievement-item-icon {
    width: 52px;
    height: 52px;
    margin-right: 14px;
    flex-shrink: 0;
    border-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.achievement-item-icon--placeholder {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.16);
}

.achievement-item--unlocked .achievement-item-icon--placeholder {
    background-color: rgba(255, 210, 90, 0.25);
    border-color: rgba(255, 210, 90, 0.7);
}

.achievement-item-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.achievement-item-header {
    flex-direction: row;
    align-items: center;
}

.achievement-item-title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(235, 235, 240);
    white-space: normal;
}

.achievement-item--unlocked .achievement-item-title {
    color: rgb(255, 220, 120);
}

.achievement-item--masked .achievement-item-title,
.achievement-item--masked .achievement-item-description {
    -unity-font-style: italic;
    color: rgb(150, 150, 160);
}

.achievement-item-progress {
    font-size: 13px;
    color: rgb(190, 190, 200);
    margin-left: 10px;
}

.achievement-item--unlocked .achievement-item-progress {
    color: rgb(255, 210, 90);
    -unity-font-style: bold;
}

.achievement-item-description {
    font-size: 13px;
    color: rgb(190, 190, 200);
    white-space: normal;
    margin-top: 2px;
}

.achievement-item-bar-track {
    height: 6px;
    margin-top: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    overflow: hidden;
}

.achievement-item-bar-fill {
    height: 100%;
    width: 0;
    background-color: rgb(255, 190, 70);
    border-radius: 3px;
}
