/* Conquistas. Rapadura theme (Common/RapaduraTheme.uss, imported first in the UXML): rap-theme on
   the root gives the palette, rap-panel / rap-heading / rap-button the window, title and Fechar.
   The rows are created in code by AchievementListController and themed on their classes here. */

.achievement-list-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(20, 10, 4, 0.86);
    display: none;
}

.achievement-list-window {
    width: 82%;
    min-width: 360px;
    max-width: 900px;
    height: 82%;
    min-height: 380px;
    background-color: var(--rap-brown-deep);
    padding: 16px 20px;
}

.achievement-list-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom-width: 2px;
    border-bottom-color: var(--rap-panel-border);
}

.achievement-list-header-texts {
    flex-grow: 1;
}

.achievement-list-title {
    font-size: 28px;
}

.achievement-list-summary {
    font-size: 14px;
    color: var(--rap-cream-dim);
}

.achievement-list-close-button {
    min-width: 96px;
    height: 44px;
    margin: 0;
    font-size: 16px;
}

.achievement-list-scroll {
    flex-grow: 1;
}

.achievement-list-empty-label {
    font-size: 15px;
    color: var(--rap-cream-dim);
    -unity-text-align: middle-center;
    margin-top: 24px;
    display: none;
}

.achievement-item {
    flex-direction: row;
    align-items: center;
    min-height: 72px;
    margin-bottom: 8px;
    padding: 10px 12px;
    background-color: rgba(86, 50, 26, 0.5);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(150, 96, 48, 0.5);
    opacity: 0.8;
}

/* Gamepad/keyboard focus (FocusNavigator steps through the rows). */
.achievement-item:focus {
    border-width: 2px;
    border-color: var(--rap-focus);
    opacity: 1;
}

.achievement-item--unlocked {
    opacity: 1;
    background-color: var(--rap-brown);
    border-color: var(--rap-gold);
}

.achievement-item-icon {
    width: 52px;
    height: 52px;
    margin-right: 14px;
    flex-shrink: 0;
    border-radius: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.achievement-item-icon--placeholder {
    background-color: rgba(28, 16, 10, 0.8);
    border-width: 2px;
    border-color: rgba(150, 96, 48, 0.6);
}

.achievement-item--unlocked .achievement-item-icon--placeholder {
    background-color: var(--rap-caramel);
    border-color: var(--rap-gold-light);
}

.achievement-item-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.achievement-item-header {
    flex-direction: row;
    align-items: center;
}

.achievement-item-title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--rap-cream);
    white-space: normal;
}

.achievement-item--unlocked .achievement-item-title {
    color: var(--rap-gold-light);
}

.achievement-item--masked .achievement-item-title,
.achievement-item--masked .achievement-item-description {
    -unity-font-style: italic;
    color: rgb(196, 176, 150);
}

.achievement-item-progress {
    font-size: 13px;
    color: var(--rap-cream-dim);
    margin-left: 10px;
}

.achievement-item--unlocked .achievement-item-progress {
    color: var(--rap-gold);
    -unity-font-style: bold;
}

.achievement-item-description {
    font-size: 13px;
    color: var(--rap-cream-dim);
    white-space: normal;
    margin-top: 2px;
}

.achievement-item-bar-track {
    height: 6px;
    margin-top: 6px;
    background-color: var(--rap-brown-night);
    border-radius: 3px;
    overflow: hidden;
}

.achievement-item-bar-fill {
    height: 100%;
    width: 0;
    background-color: var(--rap-caramel-light);
    border-radius: 3px;
}
