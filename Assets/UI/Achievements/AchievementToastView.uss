.achievement-toast-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-start;
    padding-top: 24px;
}

.achievement-toast {
    flex-direction: row;
    align-items: center;
    min-width: 320px;
    max-width: 560px;
    padding: 12px 18px;
    background-color: rgba(12, 14, 20, 0.94);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(255, 210, 90);
    opacity: 0;
    translate: 0 -40px;
    transition-property: opacity, translate;
    transition-duration: 0.3s, 0.3s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.achievement-toast--visible {
    opacity: 1;
    translate: 0 0;
}

.achievement-toast-icon {
    width: 56px;
    height: 56px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    border-radius: 8px;
}

.achievement-toast-icon--placeholder {
    background-color: rgba(255, 210, 90, 0.22);
    border-width: 2px;
    border-color: rgba(255, 210, 90, 0.6);
}

.achievement-toast-body {
    flex-shrink: 1;
    flex-grow: 1;
}

.achievement-toast-header {
    font-size: 13px;
    color: rgb(255, 210, 90);
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.achievement-toast-title {
    font-size: 18px;
    color: rgb(245, 245, 250);
    -unity-font-style: bold;
    white-space: normal;
}

.achievement-toast-description {
    font-size: 13px;
    color: rgb(190, 190, 200);
    white-space: normal;
}
