/* "Conquista desbloqueada!" toast in the Rapadura theme (Common/RapaduraTheme.uss, rap-theme on
   the root): opaque brown-sugar card with a gold frame so it reads over sand and snow. */

.achievement-toast-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-start;
    /* Below the HUD's top-right menu cluster (top 32px + 68px buttons = ~100px): at 24px a 560px
       toast centred on a ~1460px-wide phone panel covered the Missoes button (playtest r6). */
    padding-top: 112px;
}

.achievement-toast {
    flex-direction: row;
    align-items: center;
    min-width: 320px;
    max-width: 560px;
    padding: 12px 18px;
    background-color: rgb(46, 27, 16);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--rap-gold);
    border-bottom-width: 4px;
    border-bottom-color: var(--rap-caramel);
    opacity: 0;
    translate: 0 -40px;
    transition-property: opacity, translate;
    transition-duration: 0.3s, 0.3s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.achievement-toast--visible {
    opacity: 1;
    translate: 0 0;
}

/* Reduced motion (UiMotionPreferences): fade only, no slide. */
.rap-reduced-motion .achievement-toast {
    translate: 0 0;
}

.achievement-toast-icon {
    width: 56px;
    height: 56px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    border-radius: 10px;
}

.achievement-toast-icon--placeholder {
    background-color: var(--rap-caramel);
    border-width: 2px;
    border-color: var(--rap-gold-light);
}

.achievement-toast-body {
    flex-shrink: 1;
    flex-grow: 1;
}

.achievement-toast-header {
    font-size: 13px;
    color: var(--rap-gold);
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.achievement-toast-title {
    font-size: 19px;
    color: var(--rap-cream);
    -unity-font-style: bold;
    white-space: normal;
}

.achievement-toast-description {
    font-size: 13px;
    color: var(--rap-cream-dim);
    white-space: normal;
}
