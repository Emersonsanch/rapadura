.inventory-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    display: none;
}

.inventory-window {
    width: 75%;
    min-width: 520px;
    max-width: 1000px;
    height: 75%;
    min-height: 380px;
    background-color: rgba(12, 14, 20, 0.92);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    padding: 16px 20px;
}

.inventory-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.inventory-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 210, 90);
    flex-grow: 1;
}

.inventory-weight {
    color: rgb(200, 200, 205);
    margin-right: 16px;
}

/* Touch-first: 44px+ hit targets. */
.inventory-close-button {
    width: 44px;
    height: 44px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: rgb(235, 235, 240);
}

.inventory-close-button:hover {
    background-color: rgba(255, 80, 80, 0.35);
}

.inventory-panels {
    flex-direction: row;
    flex-grow: 1;
}

.inventory-panel {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 6px;
}

.inventory-panel--equipment {
    flex-grow: 0.8;
}

.inventory-panel-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(235, 235, 240);
    margin-bottom: 6px;
}

.inventory-scroll {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
}

.inventory-list {
    flex-direction: column;
    padding: 6px;
}

.inventory-row-button {
    min-height: 44px;
    margin: 3px 0;
    padding: 8px 10px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-left-width: 4px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: rgb(235, 235, 240);
    -unity-text-align: middle-left;
}

.inventory-row-button:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.inventory-row-button:disabled {
    opacity: 0.45;
}

/* Rarity accent on the left border (same reference colors as ColorblindPaletteMap). */
.inventory-row--common {
    border-left-color: rgb(199, 199, 199);
}

.inventory-row--uncommon {
    border-left-color: rgb(51, 204, 64);
}

.inventory-row--rare {
    border-left-color: rgb(51, 115, 242);
}

.inventory-row--epic {
    border-left-color: rgb(166, 64, 230);
}

.inventory-row--legendary {
    border-left-color: rgb(242, 153, 26);
}

.inventory-hint {
    margin-top: 8px;
    font-size: 11px;
    color: rgb(160, 162, 175);
    -unity-text-align: middle-center;
}
