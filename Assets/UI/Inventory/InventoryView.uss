.inventory-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    display: none;
    /* Modal backdrop: dims the world + HUD behind the window (the HUD's top-right buttons otherwise
       read as part of the window's header on 20:9 phones). */
    background-color: rgba(0, 0, 0, 0.85);
}

.inventory-window {
    width: 75%;
    min-width: 520px;
    max-width: 1000px;
    height: 75%;
    min-height: 380px;
    max-height: 92%;
    /* 0.97: in the project's linear colour space 0.92 let the grass show through strongly. */
    background-color: rgb(12, 14, 20);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    padding: 16px 20px;
}

.inventory-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.inventory-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 210, 90);
    flex-grow: 1;
}

.inventory-weight {
    color: rgb(200, 200, 205);
    margin-right: 16px;
}

/* Touch-first: 44px+ hit targets. */
.inventory-close-button {
    width: 44px;
    height: 44px;
    padding: 0;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: rgb(235, 235, 240);
}

.inventory-close-button:hover {
    background-color: rgba(255, 80, 80, 0.35);
}

.inventory-sort-button {
    height: 44px;
    margin-right: 12px;
    padding: 0 14px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: rgb(235, 235, 240);
}

.inventory-sort-button:hover {
    background-color: rgba(255, 210, 90, 0.25);
}

/* Gamepad/keyboard focus (FocusNavigator): visible on every focusable control of the window. */
.inventory-close-button:focus,
.inventory-sort-button:focus,
.inventory-row-button:focus,
.inventory-slot:focus {
    border-color: rgb(255, 210, 90);
}

.inventory-panels {
    flex-direction: row;
    flex-grow: 1;
}

.inventory-panel {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 6px;
}

.inventory-panel--equipment {
    flex-grow: 0.8;
}

.inventory-panel-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(235, 235, 240);
    margin-bottom: 6px;
}

.inventory-scroll {
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
}

.inventory-list {
    flex-direction: column;
    padding: 6px;
}

.inventory-row-button {
    min-height: 44px;
    margin: 3px 0;
    padding: 8px 10px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-left-width: 4px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: rgb(235, 235, 240);
    -unity-text-align: middle-left;
}

.inventory-row-button:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.inventory-row-button:disabled {
    opacity: 0.45;
}

/* Rarity accent on the left border (same reference colors as ColorblindPaletteMap). */
.inventory-row--common {
    border-left-color: rgb(199, 199, 199);
}

.inventory-row--uncommon {
    border-left-color: rgb(51, 204, 64);
}

.inventory-row--rare {
    border-left-color: rgb(51, 115, 242);
}

.inventory-row--epic {
    border-left-color: rgb(166, 64, 230);
}

.inventory-row--legendary {
    border-left-color: rgb(242, 153, 26);
}

/* Backpack grid: one tile per slot (empty ones too, as drop targets). 72px keeps touch targets large. */
.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.inventory-slot {
    width: 72px;
    height: 72px;
    margin: 3px;
    padding: 4px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-bottom-width: 4px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    color: rgb(235, 235, 240);
    font-size: 11px;
    white-space: normal;
    overflow: hidden;
    -unity-text-align: middle-center;
}

.inventory-slot:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.inventory-slot--empty {
    background-color: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
    border-bottom-width: 1px;
}

/* Rarity accent on the bottom border of grid tiles (left border on list rows). */
.inventory-slot.inventory-row--common {
    border-bottom-color: rgb(199, 199, 199);
}

.inventory-slot.inventory-row--uncommon {
    border-bottom-color: rgb(51, 204, 64);
}

.inventory-slot.inventory-row--rare {
    border-bottom-color: rgb(51, 115, 242);
}

.inventory-slot.inventory-row--epic {
    border-bottom-color: rgb(166, 64, 230);
}

.inventory-slot.inventory-row--legendary {
    border-bottom-color: rgb(242, 153, 26);
}

.inventory-slot-quantity {
    position: absolute;
    right: 4px;
    bottom: 2px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

/* Drag & drop feedback. */
.inventory-slot--drag-source {
    opacity: 0.4;
}

.inventory-drop--valid {
    background-color: rgba(90, 200, 110, 0.28);
    border-color: rgb(90, 200, 110);
}

.inventory-drop--invalid {
    background-color: rgba(220, 70, 70, 0.22);
    border-color: rgb(220, 70, 70);
}

.inventory-drag-ghost {
    position: absolute;
    padding: 8px 12px;
    background-color: rgba(30, 32, 42, 0.95);
    border-width: 1px;
    border-color: rgb(255, 210, 90);
    border-radius: 6px;
    color: rgb(255, 255, 255);
    font-size: 13px;
}

.inventory-hint {
    margin-top: 8px;
    font-size: 11px;
    color: rgb(160, 162, 175);
    -unity-text-align: middle-center;
}
