/* Mochila. Palette, window panel, heading, weight chip and header buttons come from
   Common/RapaduraTheme.uss (rap-theme on the root); the rows / grid tiles are created in code by
   InventoryUIController, so their themed look is spelled out on their own classes here. */

.inventory-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    display: none;
    /* Modal backdrop: dims the world + HUD behind the window (the HUD's top-right buttons otherwise
       read as part of the window's header on 20:9 phones). */
    background-color: rgba(20, 10, 4, 0.86);
}

.inventory-window {
    width: 75%;
    min-width: 520px;
    max-width: 1000px;
    height: 75%;
    min-height: 380px;
    max-height: 92%;
    /* 0.97: in the project's linear colour space 0.92 let the grass show through strongly. */
    background-color: var(--rap-brown-deep);
    padding: 16px 20px;
}

.inventory-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.inventory-title {
    font-size: 26px;
    flex-grow: 1;
}

.inventory-weight {
    margin: 0 12px 0 0;
    padding: 4px 10px;
}

/* Touch-first: 44px+ hit targets. */
.inventory-close-button {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
}

.inventory-close-button:hover {
    background-color: var(--rap-clay-red);
}

.inventory-sort-button {
    height: 44px;
    margin: 0 12px 0 0;
    padding: 0 14px;
    font-size: 16px;
}

/* Gamepad/keyboard focus (FocusNavigator): visible on every focusable control of the window. */
.inventory-row-button:focus,
.inventory-slot:focus {
    border-color: var(--rap-focus);
    background-color: rgba(196, 122, 44, 0.45);
}

.inventory-panels {
    flex-direction: row;
    flex-grow: 1;
}

.inventory-panel {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 6px;
}

.inventory-panel--equipment {
    flex-grow: 0.8;
}

.inventory-panel-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    margin-bottom: 6px;
}

.inventory-scroll {
    flex-grow: 1;
    background-color: var(--rap-brown-night);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(150, 96, 48, 0.6);
}

.inventory-list {
    flex-direction: column;
    padding: 6px;
}

.inventory-row-button {
    min-height: 44px;
    margin: 3px 0;
    padding: 8px 10px;
    background-color: var(--rap-brown);
    border-width: 1px;
    border-left-width: 4px;
    border-color: rgba(226, 158, 70, 0.45);
    border-radius: 8px;
    color: var(--rap-cream);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.inventory-row-button:hover {
    background-color: var(--rap-brown-light);
}

.inventory-row-button:disabled {
    opacity: 0.45;
}

/* Rarity accent on the left border (same reference colors as ColorblindPaletteMap). */
.inventory-row--common {
    border-left-color: rgb(199, 199, 199);
}

.inventory-row--uncommon {
    border-left-color: rgb(51, 204, 64);
}

.inventory-row--rare {
    border-left-color: rgb(51, 115, 242);
}

.inventory-row--epic {
    border-left-color: rgb(166, 64, 230);
}

.inventory-row--legendary {
    border-left-color: rgb(242, 153, 26);
}

/* Backpack grid: one tile per slot (empty ones too, as drop targets). 72px keeps touch targets large. */
.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.inventory-slot {
    width: 72px;
    height: 72px;
    margin: 3px;
    padding: 4px;
    background-color: var(--rap-brown);
    border-width: 1px;
    border-bottom-width: 4px;
    border-color: rgba(226, 158, 70, 0.45);
    border-radius: 8px;
    color: var(--rap-cream);
    font-size: 11px;
    white-space: normal;
    overflow: hidden;
    -unity-text-align: middle-center;
}

.inventory-slot:hover {
    background-color: var(--rap-brown-light);
}

.inventory-slot--empty {
    background-color: rgba(86, 50, 26, 0.35);
    border-color: rgba(150, 96, 48, 0.4);
    border-bottom-width: 1px;
}

/* Rarity accent on the bottom border of grid tiles (left border on list rows). */
.inventory-slot.inventory-row--common {
    border-bottom-color: rgb(199, 199, 199);
}

.inventory-slot.inventory-row--uncommon {
    border-bottom-color: rgb(51, 204, 64);
}

.inventory-slot.inventory-row--rare {
    border-bottom-color: rgb(51, 115, 242);
}

.inventory-slot.inventory-row--epic {
    border-bottom-color: rgb(166, 64, 230);
}

.inventory-slot.inventory-row--legendary {
    border-bottom-color: rgb(242, 153, 26);
}

.inventory-slot-quantity {
    position: absolute;
    right: 4px;
    bottom: 2px;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    text-shadow: 1px 1px 0px rgba(20, 8, 2, 0.9);
}

/* Drag & drop feedback. */
.inventory-slot--drag-source {
    opacity: 0.4;
}

.inventory-drop--valid {
    background-color: rgba(90, 200, 110, 0.28);
    border-color: rgb(90, 200, 110);
}

.inventory-drop--invalid {
    background-color: rgba(220, 70, 70, 0.22);
    border-color: rgb(220, 70, 70);
}

.inventory-drag-ghost {
    position: absolute;
    padding: 8px 12px;
    background-color: var(--rap-brown);
    border-width: 2px;
    border-color: var(--rap-gold);
    border-radius: 8px;
    color: var(--rap-cream);
    font-size: 13px;
}

.inventory-hint {
    margin-top: 8px;
    font-size: 12px;
    color: var(--rap-cream-dim);
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------------------------------------
   MU-style backpack grid (InventoryUIController.RebuildBagGrid): background cells + items drawn
   over their footprint (ItemFootprint). Positions/sizes are set in code (CellSize = 52px); the look
   lives here. Rarity colours the whole border of a grid item (same reference colours as above). */
.inventory-bag-grid {
    position: relative;
    flex-shrink: 0;
    align-self: center;
    margin: 4px;
    background-color: var(--rap-brown-night);
}

.inventory-cell {
    background-color: rgba(86, 50, 26, 0.35);
    border-width: 1px;
    border-color: rgba(150, 96, 48, 0.4);
    border-radius: 3px;
}

.inventory-cell:focus {
    background-color: rgba(196, 122, 44, 0.45);
    border-color: var(--rap-focus);
}

.inventory-slot.inventory-bag-item {
    margin: 0;
    padding: 3px;
    border-width: 2px;
    border-bottom-width: 2px;
    border-radius: 6px;
    justify-content: center;
    align-items: center;
}

.inventory-bag-item-name {
    font-size: 11px;
    color: var(--rap-cream);
    white-space: normal;
    -unity-text-align: middle-center;
}

.inventory-slot.inventory-bag-item.inventory-row--common {
    border-color: rgb(199, 199, 199);
}

.inventory-slot.inventory-bag-item.inventory-row--uncommon {
    border-color: rgb(51, 204, 64);
}

.inventory-slot.inventory-bag-item.inventory-row--rare {
    border-color: rgb(51, 115, 242);
}

.inventory-slot.inventory-bag-item.inventory-row--epic {
    border-color: rgb(166, 64, 230);
}

.inventory-slot.inventory-bag-item.inventory-row--legendary {
    border-color: rgb(242, 153, 26);
}

/* Picked up by a tap (tap-to-pick / tap-to-place). */
.inventory-slot.inventory-bag-item--held {
    opacity: 0.55;
    border-color: var(--rap-gold);
}

/* Footprint preview while dragging / holding: green = fits, red = doesn't. */
.inventory-bag-ghost {
    border-width: 2px;
    border-radius: 6px;
}

.inventory-bag-ghost--valid {
    background-color: rgba(90, 200, 110, 0.28);
    border-color: rgb(90, 200, 110);
}

.inventory-bag-ghost--invalid {
    background-color: rgba(220, 70, 70, 0.32);
    border-color: rgb(220, 70, 70);
}
