<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="/Assets/UI/Inventory/InventoryView.uss" />
    <ui:VisualElement name="inventory-root" class="inventory-root">
        <ui:VisualElement name="inventory-window" class="inventory-window">
            <ui:VisualElement name="inventory-header" class="inventory-header">
                <ui:Label name="inventory-title" text="Mochila" class="inventory-title" />
                <ui:Label name="inventory-weight" text="" class="inventory-weight" />
                <ui:Button name="inventory-close-button" text="X" class="inventory-close-button" focusable="true" />
            </ui:VisualElement>
            <ui:VisualElement name="inventory-panels" class="inventory-panels">
                <ui:VisualElement class="inventory-panel inventory-panel--equipment">
                    <ui:Label name="inventory-equipment-title" text="Equipamento" class="inventory-panel-title" />
                    <ui:ScrollView name="inventory-equipment-scroll" class="inventory-scroll">
                        <ui:VisualElement name="inventory-equipment-list" class="inventory-list" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement class="inventory-panel">
                    <ui:Label name="inventory-items-title" text="Itens" class="inventory-panel-title" />
                    <ui:ScrollView name="inventory-item-scroll" class="inventory-scroll">
                        <ui:VisualElement name="inventory-item-list" class="inventory-list" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="inventory-hint" text="" class="inventory-hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
