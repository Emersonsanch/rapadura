<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="/Assets/UI/HUD/HudView.uss" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="hud-vitals-panel" class="hud-vitals-panel" picking-mode="Ignore">
            <ui:VisualElement name="health-bar-row" class="hud-bar-row" picking-mode="Ignore">
                <ui:Label text="Vida" class="hud-bar-label loc" view-data-key="ui.hud.health" />
                <ui:VisualElement name="health-bar-track" class="hud-bar-track hud-bar-track--health" picking-mode="Ignore">
                    <ui:VisualElement name="health-bar-fill" class="hud-bar-fill hud-bar-fill--health" picking-mode="Ignore" />
                    <ui:Label name="health-bar-value-label" text="100/100" class="hud-bar-value-label" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="stamina-bar-row" class="hud-bar-row" picking-mode="Ignore">
                <ui:Label text="Stamina" class="hud-bar-label loc" view-data-key="ui.hud.stamina" />
                <ui:VisualElement name="stamina-bar-track" class="hud-bar-track hud-bar-track--stamina" picking-mode="Ignore">
                    <ui:VisualElement name="stamina-bar-fill" class="hud-bar-fill hud-bar-fill--stamina" picking-mode="Ignore" />
                    <ui:Label name="stamina-bar-value-label" text="100/100" class="hud-bar-value-label" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="mana-bar-row" class="hud-bar-row" picking-mode="Ignore">
                <ui:Label text="Mana" class="hud-bar-label loc" view-data-key="ui.hud.mana" />
                <ui:VisualElement name="mana-bar-track" class="hud-bar-track hud-bar-track--mana" picking-mode="Ignore">
                    <ui:VisualElement name="mana-bar-fill" class="hud-bar-fill hud-bar-fill--mana" picking-mode="Ignore" />
                    <ui:Label name="mana-bar-value-label" text="100/100" class="hud-bar-value-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="hud-xp-panel" class="hud-xp-panel" picking-mode="Ignore">
            <ui:VisualElement name="xp-bar-row" class="hud-bar-row hud-bar-row--xp" picking-mode="Ignore">
                <ui:Label name="level-label" text="Nv. 1" class="hud-bar-label hud-level-label" />
                <ui:VisualElement name="xp-bar-track" class="hud-bar-track hud-bar-track--xp" picking-mode="Ignore">
                    <ui:VisualElement name="xp-bar-fill" class="hud-bar-fill hud-bar-fill--xp" picking-mode="Ignore" />
                    <ui:Label name="xp-bar-value-label" text="0/100" class="hud-bar-value-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="run-button" text="Correr" class="hud-touch-button hud-run-button loc" view-data-key="ui.hud.run" />
        <ui:Button name="jump-button" text="Pular" class="hud-touch-button hud-jump-button loc" view-data-key="ui.hud.jump" />
        <ui:Button name="attack-button" text="Atacar" class="hud-touch-button hud-attack-button hud-hidden loc" view-data-key="ui.hud.attack" />
        <ui:VisualElement name="hud-camera-cluster" class="hud-camera-cluster hud-hidden" picking-mode="Ignore">
            <ui:Button name="camera-left-button" text="‹ Girar" class="hud-touch-button hud-camera-button loc" view-data-key="ui.hud.camera_left" />
            <ui:Button name="camera-right-button" text="Girar ›" class="hud-touch-button hud-camera-button loc" view-data-key="ui.hud.camera_right" />
        </ui:VisualElement>
        <ui:VisualElement name="virtual-joystick" class="hud-joystick hud-hidden">
            <ui:VisualElement name="virtual-joystick-knob" class="hud-joystick-knob" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="hud-top-right-cluster" class="hud-top-right-cluster" picking-mode="Ignore">
            <ui:Button name="quests-button" text="Missões" class="hud-touch-button hud-menu-button hud-quests-button loc" view-data-key="ui.hud.quests" />
            <ui:Button name="inventory-button" text="Mochila" class="hud-touch-button hud-menu-button hud-inventory-button loc" view-data-key="ui.hud.inventory" />
            <ui:Button name="character-sheet-button" text="Ficha" class="hud-touch-button hud-menu-button hud-character-sheet-button loc" view-data-key="ui.hud.character_sheet">
                <ui:Label name="character-sheet-badge" text="" class="hud-menu-badge hud-menu-badge--hidden" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="skills-button" text="Skills" class="hud-touch-button hud-menu-button hud-skills-button loc" view-data-key="ui.hud.skills" />
            <ui:Button name="pause-button" text="Menu" class="hud-touch-button hud-menu-button hud-pause-button loc" view-data-key="ui.hud.menu" />
        </ui:VisualElement>
        <ui:VisualElement name="skill-hotbar" class="hud-skill-hotbar" picking-mode="Ignore">
            <ui:Button name="skill-slot-0" class="hud-touch-button hud-skill-button hud-skill-button--empty">
                <ui:VisualElement name="skill-slot-0-icon" class="hud-skill-icon" picking-mode="Ignore" />
                <ui:Label name="skill-slot-0-name" text="" class="hud-skill-name" picking-mode="Ignore" />
                <ui:VisualElement name="skill-slot-0-cooldown" class="hud-skill-cooldown-overlay" picking-mode="Ignore" />
                <ui:Label name="skill-slot-0-cooldown-label" text="" class="hud-skill-cooldown-label" picking-mode="Ignore" />
                <ui:Label name="skill-slot-0-key" text="1" class="hud-skill-key-hint" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="skill-slot-1" class="hud-touch-button hud-skill-button hud-skill-button--empty">
                <ui:VisualElement name="skill-slot-1-icon" class="hud-skill-icon" picking-mode="Ignore" />
                <ui:Label name="skill-slot-1-name" text="" class="hud-skill-name" picking-mode="Ignore" />
                <ui:VisualElement name="skill-slot-1-cooldown" class="hud-skill-cooldown-overlay" picking-mode="Ignore" />
                <ui:Label name="skill-slot-1-cooldown-label" text="" class="hud-skill-cooldown-label" picking-mode="Ignore" />
                <ui:Label name="skill-slot-1-key" text="2" class="hud-skill-key-hint" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="skill-slot-2" class="hud-touch-button hud-skill-button hud-skill-button--empty">
                <ui:VisualElement name="skill-slot-2-icon" class="hud-skill-icon" picking-mode="Ignore" />
                <ui:Label name="skill-slot-2-name" text="" class="hud-skill-name" picking-mode="Ignore" />
                <ui:VisualElement name="skill-slot-2-cooldown" class="hud-skill-cooldown-overlay" picking-mode="Ignore" />
                <ui:Label name="skill-slot-2-cooldown-label" text="" class="hud-skill-cooldown-label" picking-mode="Ignore" />
                <ui:Label name="skill-slot-2-key" text="3" class="hud-skill-key-hint" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="skill-slot-3" class="hud-touch-button hud-skill-button hud-skill-button--empty">
                <ui:VisualElement name="skill-slot-3-icon" class="hud-skill-icon" picking-mode="Ignore" />
                <ui:Label name="skill-slot-3-name" text="" class="hud-skill-name" picking-mode="Ignore" />
                <ui:VisualElement name="skill-slot-3-cooldown" class="hud-skill-cooldown-overlay" picking-mode="Ignore" />
                <ui:Label name="skill-slot-3-cooldown-label" text="" class="hud-skill-cooldown-label" picking-mode="Ignore" />
                <ui:Label name="skill-slot-3-key" text="4" class="hud-skill-key-hint" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="skill-slot-4" class="hud-touch-button hud-skill-button hud-skill-button--empty">
                <ui:VisualElement name="skill-slot-4-icon" class="hud-skill-icon" picking-mode="Ignore" />
                <ui:Label name="skill-slot-4-name" text="" class="hud-skill-name" picking-mode="Ignore" />
                <ui:VisualElement name="skill-slot-4-cooldown" class="hud-skill-cooldown-overlay" picking-mode="Ignore" />
                <ui:Label name="skill-slot-4-cooldown-label" text="" class="hud-skill-cooldown-label" picking-mode="Ignore" />
                <ui:Label name="skill-slot-4-key" text="5" class="hud-skill-key-hint" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
