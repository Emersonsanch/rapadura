.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.hud-vitals-panel {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 260px;
    flex-direction: column;
    background-color: rgba(12, 14, 20, 0.55);
    border-radius: 8px;
    padding: 10px 12px;
}

.hud-touch-button {
    position: absolute;
    width: 84px;
    height: 84px;
    border-radius: 42px;
    background-color: rgba(40, 44, 56, 0.55);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
    color: rgb(240, 240, 240);
    font-size: 16px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.hud-run-button {
    right: 32px;
    bottom: 32px;
}

.hud-jump-button {
    right: 130px;
    bottom: 32px;
    width: 68px;
    height: 68px;
    border-radius: 34px;
    font-size: 14px;
}

/* ---- Top-right menu cluster (Missões / Mochila / Ficha / Skills / Menu) ----
   A flex row instead of per-button absolute offsets, so buttons can never overlap each other
   when UiAccessibilityApplier scales their text: each one grows horizontally (min-width keeps the
   68px round touch target at scale 1, padding keeps the label off the border) and the row just
   gets wider toward the vitals panel. Budget at 2400x1080 (panel ~1461x657 with the 1200x800
   reference / match 0.5, minus ~60px per side of notch safe area): the row is ~460px at scale 1
   and ~600px at the 2x max (5 buttons), vs ~1060px of free width right of the vitals panel. Vertically it ends
   ~100px from the top, far above the skill hotbar (bottom 132px + 64px). Conquistas and Criação
   live in the Pause menu instead (rarely used; see PauseMenuController). */
.hud-top-right-cluster {
    position: absolute;
    top: 32px;
    right: 32px;
    flex-direction: row;
    align-items: center;
}

/* Overrides .hud-touch-button's absolute positioning so the buttons lay out in the cluster row. */
.hud-menu-button {
    position: relative;
    min-width: 68px;
    width: auto;
    height: 68px;
    border-radius: 34px;
    margin: 0 0 0 30px;
    padding: 0 10px;
    font-size: 13px;
    white-space: nowrap;
}

.hud-quests-button {
    margin-left: 0;
}

/* Unspent attribute points on the "Ficha" button (HudController.ApplyBadge). Absolute, so it never
   changes the button's size / the cluster's flex layout; picking-mode Ignore in the UXML. */
.hud-menu-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 24px;
    height: 24px;
    padding: 0 6px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(255, 245, 225);
    background-color: rgb(220, 60, 50);
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hud-menu-badge--hidden {
    display: none;
}

.hud-touch-button--active {
    background-color: rgba(90, 160, 90, 0.75);
    border-color: rgb(200, 255, 200);
}

/* Touch-only controls (Atacar, camera rotate, virtual joystick) start hidden; HudController removes
   this class only when a touchscreen exists (and, for the joystick, when it's enabled in Settings). */
.hud-hidden {
    display: none;
}

/* ---- Bottom-right action row: [Atacar] [Pular] [Correr], under the skill hotbar ----
   Atacar sits left of Pular (Correr keeps the corner, where the thumb rests while sprinting). It
   grows to the LEFT when UiAccessibilityApplier scales its text (right-anchored, width auto), where
   the row has free space: the whole row is ~290px wide at scale 1 vs the ~360px hotbar above it.
   Hotbar starts 132px from the bottom, so the 76px button (bottom 32) leaves a 24px gap. */
.hud-attack-button {
    right: 212px;
    bottom: 32px;
    min-width: 76px;
    width: auto;
    height: 76px;
    border-radius: 38px;
    padding: 0 10px;
    font-size: 15px;
    white-space: nowrap;
    background-color: rgba(120, 40, 36, 0.6);
    border-color: rgba(255, 190, 170, 0.55);
}

/* ---- Camera rotate (CameraController.RotateLeft/Right; Q/E on keyboard) ----
   Bottom-right, right-aligned just above the skill hotbar (hotbar bottom 132px + 64px slots = 196px,
   so bottom 208px leaves a 12px gap). It used to sit under the top-right menu cluster (top 116px),
   where it covered the QuestTracker card's title (right edge, top 130px) at 2400 and 1920 widths;
   down here the only neighbours are the hotbar/action row, which never grow upward. 48px tall
   pills: above the 44px minimum touch target, smaller than the menu buttons since they're used less. */
.hud-camera-cluster {
    position: absolute;
    bottom: 208px;
    right: 32px;
    flex-direction: row;
    align-items: center;
}

.hud-camera-button {
    position: relative;
    min-width: 64px;
    width: auto;
    height: 48px;
    border-radius: 24px;
    margin: 0 0 0 12px;
    padding: 0 12px;
    font-size: 12px;
    white-space: nowrap;
}

/* ---- Optional virtual joystick (Settings > Controles > Joystick virtual, touch only) ----
   Bottom-left, above the XP bar (bottom 24px, ~18px tall) and far below the vitals panel. 150px base
   / 64px knob; HudController moves the knob with translate and writes PlayerInputHandler.TouchMoveInput.
   The base draws a background, so UiPointerQuery treats it as UI (no tap-to-move under the thumb). */
.hud-joystick {
    position: absolute;
    left: 40px;
    bottom: 64px;
    width: 150px;
    height: 150px;
    border-radius: 75px;
    background-color: rgba(40, 44, 56, 0.35);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.3);
    align-items: center;
    justify-content: center;
}

.hud-joystick-knob {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgba(230, 230, 240, 0.55);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.8);
}

.hud-joystick--active {
    border-color: rgb(200, 255, 200);
}

.hud-xp-panel {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 400px;
    flex-direction: column;
}

.hud-bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.hud-bar-row--xp {
    margin-bottom: 0;
}

.hud-bar-label {
    width: 56px;
    font-size: 11px;
    color: rgb(220, 220, 225);
    -unity-font-style: bold;
}

.hud-level-label {
    width: 44px;
    color: rgb(255, 210, 90);
}

.hud-bar-track {
    flex-grow: 1;
    height: 16px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    overflow: hidden;
    position: relative;
}

.hud-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    transition-property: width;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.hud-bar-fill--health {
    background-color: rgb(210, 60, 60);
}

.hud-bar-fill--stamina {
    background-color: rgb(220, 190, 60);
}

.hud-bar-fill--mana {
    background-color: rgb(70, 130, 220);
}

.hud-bar-fill--xp {
    background-color: rgb(150, 90, 220);
}

.hud-bar-value-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 10px;
    color: rgb(240, 240, 245);
    -unity-font-style: bold;
    /* White on the yellow stamina fill was unreadable at phone DPI; a dark drop shadow keeps the
       value legible on every fill colour. */
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.95);
}

/* Low-value warning state: applied by HudController when a vital drops below its threshold. */
.hud-bar-fill--low {
    background-color: rgb(255, 90, 40);
}

/* ---- Skill hotbar (5 touch slots above Run/Jump; driven by HudController + SkillHotbar) ---- */

.hud-skill-hotbar {
    position: absolute;
    right: 32px;
    bottom: 132px;
    flex-direction: row;
    align-items: flex-end;
}

/* Inherits the round translucent look from .hud-touch-button; overrides absolute positioning
   so the 5 slots lay out in a row inside .hud-skill-hotbar. */
.hud-skill-button {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    margin-left: 8px;
    padding: 0;
    overflow: hidden;
    font-size: 10px;
}

.hud-skill-icon {
    position: absolute;
    left: 8px;
    top: 8px;
    right: 8px;
    bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-skill-name {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 0;
    bottom: 0;
    font-size: 9px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    /* nowrap: HudController pre-formats the name (SkillSlotDisplayMath.FormatSlotName) into short
       whole-word lines joined by explicit newlines, so UI Toolkit never breaks a word mid-way
       ("Explosiv / o"). overflow: hidden is a last-resort clip under extreme font scaling. */
    white-space: nowrap;
    overflow: hidden;
}

/* Name label is only a fallback for skills without an icon (HudController hides it otherwise). */
.hud-skill-name--hidden {
    display: none;
}

/* Fills from the bottom; HudController sets height to the remaining-cooldown percentage. */
.hud-skill-cooldown-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgba(0, 0, 0, 0.6);
}

.hud-skill-cooldown-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.hud-skill-key-hint {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    -unity-text-align: upper-center;
    font-size: 9px;
    color: rgba(255, 255, 255, 0.6);
}

.hud-skill-button--empty {
    opacity: 0.4;
}

.hud-skill-button--cooldown {
    border-color: rgba(255, 255, 255, 0.15);
}

/* While cooling down the centered countdown (.hud-skill-cooldown-label) owns the slot: the
   fallback name would print right under the digits, so it's hidden (visibility keeps the layout)
   and the icon dims behind the number. */
.hud-skill-button--cooldown .hud-skill-name {
    visibility: hidden;
}

.hud-skill-button--cooldown .hud-skill-icon {
    opacity: 0.45;
}

/* Not enough mana/energy to pay the skill's cost right now. */
.hud-skill-button--no-mana {
    border-color: rgb(70, 130, 220);
    background-color: rgba(30, 40, 90, 0.6);
}

.hud-skill-button--no-mana .hud-skill-icon {
    -unity-background-image-tint-color: rgb(110, 120, 170);
}
