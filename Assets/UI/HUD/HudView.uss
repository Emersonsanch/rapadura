.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.hud-vitals-panel {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 260px;
    flex-direction: column;
    background-color: rgba(12, 14, 20, 0.55);
    border-radius: 8px;
    padding: 10px 12px;
}

.hud-touch-button {
    position: absolute;
    width: 84px;
    height: 84px;
    border-radius: 42px;
    background-color: rgba(40, 44, 56, 0.55);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
    color: rgb(240, 240, 240);
    font-size: 16px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.hud-run-button {
    right: 32px;
    bottom: 32px;
}

.hud-jump-button {
    right: 130px;
    bottom: 32px;
    width: 68px;
    height: 68px;
    border-radius: 34px;
    font-size: 14px;
}

.hud-skills-button {
    top: 32px;
    right: 130px;
    width: 68px;
    height: 68px;
    border-radius: 34px;
    font-size: 14px;
}

.hud-inventory-button {
    top: 32px;
    right: 228px;
    width: 68px;
    height: 68px;
    border-radius: 34px;
    font-size: 13px;
}

.hud-pause-button {
    top: 32px;
    right: 32px;
    width: 68px;
    height: 68px;
    border-radius: 34px;
    font-size: 14px;
}

.hud-touch-button--active {
    background-color: rgba(90, 160, 90, 0.75);
    border-color: rgb(200, 255, 200);
}

.hud-xp-panel {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 400px;
    flex-direction: column;
}

.hud-bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.hud-bar-row--xp {
    margin-bottom: 0;
}

.hud-bar-label {
    width: 56px;
    font-size: 11px;
    color: rgb(220, 220, 225);
    -unity-font-style: bold;
}

.hud-level-label {
    width: 44px;
    color: rgb(255, 210, 90);
}

.hud-bar-track {
    flex-grow: 1;
    height: 16px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    overflow: hidden;
    position: relative;
}

.hud-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    transition-property: width;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.hud-bar-fill--health {
    background-color: rgb(210, 60, 60);
}

.hud-bar-fill--stamina {
    background-color: rgb(220, 190, 60);
}

.hud-bar-fill--mana {
    background-color: rgb(70, 130, 220);
}

.hud-bar-fill--xp {
    background-color: rgb(150, 90, 220);
}

.hud-bar-value-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 10px;
    color: rgb(240, 240, 245);
}

/* Low-value warning state: applied by HudController when a vital drops below its threshold. */
.hud-bar-fill--low {
    background-color: rgb(255, 90, 40);
}

/* ---- Skill hotbar (5 touch slots above Run/Jump; driven by HudController + SkillHotbar) ---- */

.hud-skill-hotbar {
    position: absolute;
    right: 32px;
    bottom: 132px;
    flex-direction: row;
    align-items: flex-end;
}

/* Inherits the round translucent look from .hud-touch-button; overrides absolute positioning
   so the 5 slots lay out in a row inside .hud-skill-hotbar. */
.hud-skill-button {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    margin-left: 8px;
    padding: 0;
    overflow: hidden;
    font-size: 10px;
}

.hud-skill-icon {
    position: absolute;
    left: 8px;
    top: 8px;
    right: 8px;
    bottom: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-skill-name {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 0;
    bottom: 0;
    font-size: 9px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    white-space: normal;
}

/* Name label is only a fallback for skills without an icon (HudController hides it otherwise). */
.hud-skill-name--hidden {
    display: none;
}

/* Fills from the bottom; HudController sets height to the remaining-cooldown percentage. */
.hud-skill-cooldown-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgba(0, 0, 0, 0.6);
}

.hud-skill-cooldown-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.hud-skill-key-hint {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    -unity-text-align: upper-center;
    font-size: 9px;
    color: rgba(255, 255, 255, 0.6);
}

.hud-skill-button--empty {
    opacity: 0.4;
}

.hud-skill-button--cooldown {
    border-color: rgba(255, 255, 255, 0.15);
}

/* Not enough mana/energy to pay the skill's cost right now. */
.hud-skill-button--no-mana {
    border-color: rgb(70, 130, 220);
    background-color: rgba(30, 40, 90, 0.6);
}

.hud-skill-button--no-mana .hud-skill-icon {
    -unity-background-image-tint-color: rgb(110, 120, 170);
}
