.character-select__root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(10, 10, 18); /* opaque: the world map renders behind the front-end */
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.character-select__title {
    font-size: 32px;
    color: rgb(230, 220, 190);
    -unity-font-style: bold;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.character-select__body {
    flex-direction: row;
    width: 90%;
    max-width: 1000px;
    /* Fill the space left under the title instead of a fixed 60% — on landscape phones (≈660 logical px
       tall) a fixed percentage left the detail column shorter than its content, so the story ran into
       the Confirmar button. */
    flex-grow: 1;
    flex-shrink: 1;
    max-height: 560px;
    min-height: 0;
}

.character-select__roster {
    width: 200px;
    margin-right: 20px;
    flex-shrink: 0;
}

.character-select__roster-button {
    height: 48px;
    margin-bottom: 8px;
    font-size: 18px;
    background-color: rgb(40, 36, 60);
    color: rgb(230, 220, 190);
    border-width: 1px;
    border-color: rgb(90, 80, 120);
}

.character-select__roster-button:hover {
    background-color: rgb(70, 60, 100);
}

/* The hero shown in the detail panel (what "Confirmar" picks): gold frame, lit background. */
.character-select__roster-button--selected,
.character-select__roster-button--selected:hover {
    background-color: rgb(92, 74, 40);
    color: rgb(255, 236, 180);
    border-width: 3px;
    border-color: rgb(255, 210, 90);
    -unity-font-style: bold;
}

.character-select__detail {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 302px;
    background-color: rgba(30, 26, 46, 0.85);
    padding: 20px;
    /* Landscape layout: the 3D preview is pinned to the left column (absolute), text + buttons
       flow in the right column. */
    padding-left: 304px;
    border-width: 1px;
    border-color: rgb(90, 80, 120);
}

.character-select__detail-preview {
    width: 260px;
    height: 260px;
    min-height: 260px;
    flex-shrink: 0;
    flex-grow: 0;
    position: absolute;
    left: 20px;
    top: 20px;
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 1px;
    border-color: rgb(90, 80, 120);
    -unity-background-scale-mode: scale-to-fit;
}

.character-select__detail-name {
    font-size: 28px;
    color: rgb(255, 240, 200);
    -unity-font-style: bold;
}

.character-select__detail-role {
    font-size: 16px;
    color: rgb(200, 190, 220);
    margin-bottom: 12px;
}

/* Story text scrolls inside the remaining space so it can never push into the buttons. */
.character-select__detail-lore-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 40px;
}

.character-select__detail-lore {
    font-size: 15px;
    color: rgb(220, 215, 230);
    white-space: normal;
    padding-right: 6px;
}

.character-select__confirm {
    height: 44px;
    flex-shrink: 0;
    font-size: 18px;
    margin-top: 12px;
    background-color: rgb(120, 40, 40);
    color: rgb(255, 240, 220);
}

/* "Continuar com <herói>" — only shown when a save with a chosen hero exists (CharacterSelectController.RefreshContinueOption). */
.character-select__continue {
    margin-top: 8px;
    background-color: rgb(40, 90, 60);
}
