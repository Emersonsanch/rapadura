/* Same Rapadura theme as PauseMenuView.uss (Common/RapaduraTheme.uss, rap-theme on this root) —
   this dialog is drawn over the pause panel. */
.return-title-dialog {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    /* Opaque full-screen backdrop: at 0.6 the taller pause panel behind it peeked out above and
       below this dialog's panel (playtest), reading as two stacked menus. */
    background-color: rgb(24, 13, 7);
    display: none;
}

.return-title-panel {
    width: 380px;
    max-width: 90%;
    align-items: center;
    padding: 22px 24px 14px 24px;
    background-color: var(--rap-brown-deep);
}

.return-title-title {
    font-size: 26px;
    margin-bottom: 8px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.return-title-message {
    font-size: 16px;
    color: var(--rap-cream-dim);
    margin-bottom: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.return-title-button-list {
    width: 100%;
    flex-direction: column;
}

.return-title-button {
    width: 100%;
    /* min-height (not height) so the label can grow with the accessibility font scale. */
    height: auto;
    min-height: 48px;
    white-space: normal;
    margin-bottom: 8px;
    font-size: 17px;
}

/* "Sair sem salvar": clay red so the destructive choice never relies on wording alone. */
.return-title-button--danger {
    background-color: rgb(120, 40, 22);
    border-left-color: rgb(200, 100, 70);
    border-right-color: rgb(200, 100, 70);
    border-top-color: rgb(230, 130, 96);
}

.return-title-button--danger:hover {
    background-color: rgb(146, 52, 28);
}
