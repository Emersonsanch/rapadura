/*
 * Festa Junina, built in code: the "Arraiá" window (FestaJuninaPanel, on top of the Mochila overlay classes
 * .wm-backpack-overlay / .wm-backpack-panel) with the quadrilha rhythm game and the Barraca de Prendas. Loaded at
 * runtime from Resources and attached to the window root, which sits under the HUD's `rap-theme` root (wm-hud-root),
 * where the palette below resolves.
 */

@import url("/Assets/UI/Common/RapaduraTheme.uss");

.festa-panel {
    width: 640px;
    max-width: 94%;
    max-height: 96%;
    padding: 16px 20px;
}

.festa-prendas {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--rap-gold);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.festa-line {
    font-size: 13px;
    -unity-font-style: italic;
    color: var(--rap-cream);
    white-space: normal;
    padding: 6px 10px;
    margin-bottom: 8px;
    border-left-width: 3px;
    border-left-color: var(--rap-clay-red);
    background-color: var(--rap-brown-night);
    border-radius: 6px;
}

.festa-tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 8px;
}

.festa-tab {
    margin-left: 4px;
    margin-right: 4px;
}

.festa-tab--active {
    border-color: var(--rap-gold);
    background-color: var(--rap-caramel);
}

.festa-page {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 220px;
}

.festa-intro {
    font-size: 12px;
    color: var(--rap-cream-dim);
    white-space: normal;
    margin-bottom: 6px;
}

/* ---- Quadrilha ---- */

.festa-track {
    height: 64px;
    margin-top: 4px;
    margin-bottom: 6px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--rap-panel-border);
    background-color: var(--rap-brown-night);
    overflow: hidden;
}

.festa-hit-zone {
    position: absolute;
    left: 12%;
    width: 52px;
    top: 4px;
    bottom: 4px;
    margin-left: -26px;
    border-radius: 26px;
    border-width: 3px;
    border-color: var(--rap-gold);
    background-color: rgba(244, 196, 88, 0.18);
}

.festa-note {
    position: absolute;
    width: 44px;
    height: 44px;
    top: 8px;
    margin-left: -22px;
    border-radius: 22px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--rap-brown-night);
    background-color: var(--rap-cream);
}

.festa-note--anarrie { background-color: rgb(206, 72, 60); color: var(--rap-cream); }
.festa-note--balance { background-color: var(--rap-gold); }
.festa-note--cobra { background-color: rgb(96, 170, 214); }
.festa-note--caminho { background-color: var(--rap-cane-green); color: var(--rap-cream); }

.festa-call {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    -unity-text-align: middle-center;
    min-height: 28px;
}

.festa-judge {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    min-height: 22px;
    color: var(--rap-cream);
}

.festa-judge--perfect { color: var(--rap-gold); }
.festa-judge--good { color: var(--rap-cane-green); }
.festa-judge--miss { color: var(--rap-warning); }

.festa-score {
    font-size: 12px;
    color: var(--rap-cream-dim);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.festa-moves {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.festa-move {
    min-width: 130px;
    margin: 3px;
}

.festa-result {
    font-size: 13px;
    color: var(--rap-cream);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.festa-relaxed {
    align-self: center;
    margin-bottom: 6px;
}

/* ---- Barraca de Prendas ---- */

.festa-tasks {
    font-size: 12px;
    color: var(--rap-cream);
    white-space: normal;
    padding: 4px 8px;
    margin-bottom: 6px;
    border-radius: 6px;
    background-color: var(--rap-brown-deep);
}

.festa-stall-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 160px;
}

.festa-prize {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    margin-bottom: 5px;
    background-color: var(--rap-brown);
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--rap-panel-border);
}

.festa-prize--owned {
    border-color: var(--rap-cane-green);
}

.festa-prize__body {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 10px;
}

.festa-prize__name {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--rap-cream);
    white-space: normal;
}

.festa-prize__info {
    font-size: 11px;
    color: var(--rap-cream-dim);
    white-space: normal;
}

.festa-status {
    font-size: 13px;
    color: var(--rap-gold-light);
    white-space: normal;
    -unity-text-align: middle-center;
    min-height: 18px;
    margin-top: 4px;
}
