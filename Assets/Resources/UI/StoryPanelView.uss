/* Campaign story panels (StoryPanelController). Rapadura theme (Common/RapaduraTheme.uss, imported
   first in the UXML): rap-theme on the root, rap-panel card, rap-heading title, rap-button
   Pular / rap-button--primary Continuar. Same warm palette as TutorialHintView.uss. */
.story-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 24px;
    /* Dimmed, not black: the map stays faintly visible behind the story. */
    background-color: rgba(20, 10, 4, 0.88);
    display: none;
}

.story-card {
    width: 86%;
    max-width: 640px;
    padding: 20px 24px 16px 24px;
    background-color: var(--rap-brown-deep);
    border-radius: 14px;
    border-width: 3px;
    /* Overridden in code with the chosen hero's accent colour. */
    border-color: var(--rap-gold);
}

.story-title {
    font-size: 20px;
    white-space: normal;
    margin-bottom: 10px;
}

.story-body {
    font-size: 19px;
    color: var(--rap-cream);
    white-space: normal;
    /* Room for 3-5 lines so the card does not jump between panels. */
    min-height: 120px;
    margin-bottom: 14px;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.3s, 0.3s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

/* Applied for one frame on every new panel, then removed so the text fades/slides in. */
.story-body--entering {
    opacity: 0;
    translate: 0 8px;
}

/* Reduce flash / motion: text swaps instantly. */
.story-body--no-motion {
    transition-duration: 0s, 0s;
    translate: 0 0;
}

.story-footer {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.story-progress {
    font-size: 14px;
    color: var(--rap-cream-dim);
    margin-right: 10px;
}

.story-tap-hint {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 14px;
    color: var(--rap-cream-dim);
    -unity-font-style: italic;
    white-space: normal;
}

/* Touch targets >= 44px tall; min-height so labels grow with the accessibility font scale. */
.story-button {
    min-width: 112px;
    height: auto;
    min-height: 46px;
    font-size: 17px;
    margin: 4px 0 4px 8px;
    white-space: normal;
}
