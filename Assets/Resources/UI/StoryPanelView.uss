/* Campaign story panels (StoryPanelController). Same warm palette as TutorialHintView.uss. */
.story-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    padding: 24px;
    /* Dimmed, not black: the map stays faintly visible behind the story. */
    background-color: rgba(12, 8, 4, 0.88);
    display: none;
}

.story-card {
    width: 86%;
    max-width: 640px;
    padding: 20px 24px 16px 24px;
    background-color: rgb(34, 22, 12);
    border-radius: 14px;
    border-width: 3px;
    /* Overridden in code with the chosen hero's accent colour. */
    border-color: rgb(240, 178, 70);
}

.story-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 178, 70);
    white-space: normal;
    margin-bottom: 10px;
}

.story-body {
    font-size: 19px;
    color: rgb(255, 248, 235);
    white-space: normal;
    /* Room for 3-5 lines so the card does not jump between panels. */
    min-height: 120px;
    margin-bottom: 14px;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.3s, 0.3s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

/* Applied for one frame on every new panel, then removed so the text fades/slides in. */
.story-body--entering {
    opacity: 0;
    translate: 0 8px;
}

/* Reduce flash / motion: text swaps instantly. */
.story-body--no-motion {
    transition-duration: 0s, 0s;
    translate: 0 0;
}

.story-footer {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.story-progress {
    font-size: 13px;
    color: rgb(200, 180, 150);
    margin-right: 10px;
}

.story-tap-hint {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 13px;
    color: rgb(200, 180, 150);
    -unity-font-style: italic;
    white-space: normal;
}

/* Touch targets >= 44px tall; min-height so labels grow with the accessibility font scale. */
.story-button {
    min-width: 112px;
    min-height: 44px;
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 10px;
    margin: 4px 0 4px 8px;
    white-space: normal;
}

.story-button--skip {
    color: rgb(240, 230, 215);
    background-color: rgba(70, 50, 30, 0.9);
    border-width: 2px;
    border-color: rgba(240, 178, 70, 0.35);
}

.story-button--skip:hover {
    background-color: rgba(95, 70, 42, 0.95);
}

.story-button--next {
    color: rgb(34, 22, 12);
    background-color: rgb(240, 178, 70);
    border-width: 0;
}

.story-button--next:hover {
    background-color: rgb(250, 200, 100);
}

.story-button:focus {
    border-width: 3px;
    border-color: rgb(255, 248, 235);
}
