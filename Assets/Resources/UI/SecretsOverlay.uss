/*
 * "Segredos e áreas ocultas", built in code (no UXML): the "Investigar" button and the "Relíquias do Sertão"
 * panel injected into the world map HUD (SecretsMapButtons, RelicCollectionView) and the secrets toast shown on
 * the map and in the arenas (SecretToastController). Loaded at runtime from Resources (SecretsStyles), which also
 * puts `rap-theme` on the roots it styles so the palette below resolves.
 */

@import url("/Assets/UI/Common/RapaduraTheme.uss");

/* ---- "Investigar" (carries .wm-explore-button for size and shape) ---- */

.wm-secret-button {
    margin-left: 8px;
    background-color: var(--rap-cane-green);
    border-color: var(--rap-gold-light);
    border-bottom-color: rgb(40, 58, 20);
}

.wm-secret-button:hover {
    background-color: rgb(132, 168, 76);
}

.wm-secret-button:active {
    background-color: rgb(84, 112, 44);
}

/* Entry inside the Mochila summary. */
.wm-relics-entry {
    margin-top: 10px;
}

/* ---- Relic collection panel ---- */

.relic-overlay {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 10, 4, 0.86);
}

.relic-panel {
    width: 620px;
    max-width: 94%;
    max-height: 90%;
    padding: 18px 20px;
    background-color: var(--rap-brown-deep);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--rap-panel-border);
}

.relic-title {
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--rap-gold-light);
}

.relic-subtitle {
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--rap-cream-dim);
    margin-bottom: 4px;
}

.relic-count {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--rap-gold);
}

.relic-note {
    font-size: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--rap-cream);
    margin-bottom: 6px;
}

.relic-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 120px;
    margin: 6px 0 10px 0;
}

.relic-row {
    flex-direction: row;
    padding: 8px 10px;
    margin-bottom: 6px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--rap-brown-light);
    background-color: var(--rap-brown);
}

.relic-row--missing {
    background-color: rgb(38, 22, 13);
    border-color: rgb(70, 44, 24);
}

.relic-gem {
    width: 18px;
    height: 18px;
    margin: 3px 10px 0 0;
    border-radius: 9px;
    border-width: 2px;
    border-color: var(--rap-gold);
    background-color: var(--rap-gold);
    flex-shrink: 0;
}

.relic-row--missing .relic-gem {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--rap-brown-light);
}

.relic-gem--forest { background-color: rgb(112, 170, 70); }
.relic-gem--desert { background-color: rgb(236, 196, 110); }
.relic-gem--mountain { background-color: rgb(170, 180, 196); }
.relic-gem--caves { background-color: rgb(120, 200, 226); }

.relic-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.relic-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
}

.relic-row--missing .relic-name {
    color: var(--rap-cream-dim);
}

.relic-tag {
    font-size: 11px;
    color: var(--rap-caramel-light);
}

.relic-passive {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(186, 226, 132);
}

.relic-body {
    font-size: 12px;
    white-space: normal;
    color: var(--rap-cream);
}

.relic-row--missing .relic-body {
    -unity-font-style: italic;
    color: var(--rap-cream-dim);
}

.relic-close {
    align-self: center;
    min-width: 160px;
}

/* ---- Toast (map and arena) ---- */

.secret-toast-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 20%;
    align-items: center;
}

.secret-toast {
    display: none;
    max-width: 80%;
    padding: 10px 26px 12px 26px;
    align-items: center;
    background-color: var(--rap-brown-night);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-color: var(--rap-gold);
    border-bottom-color: var(--rap-gold);
}

.secret-toast-title {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--rap-gold);
    text-shadow: 1.5px 1.5px 2px rgba(0, 0, 0, 0.9);
}

.secret-toast-body {
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--rap-cream);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}
