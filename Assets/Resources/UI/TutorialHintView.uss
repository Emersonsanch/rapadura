.tutorial-hint-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-start;
    padding-top: 16%;
    padding-left: 16px;
    padding-right: 16px;
}

.tutorial-hint {
    width: 90%;
    max-width: 540px;
    padding: 14px 20px 14px 20px;
    background-color: rgba(34, 22, 12, 0.95);
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(240, 178, 70);
    align-items: stretch;
    display: none;
    opacity: 0;
    translate: 0 -24px;
    transition-property: opacity, translate;
    transition-duration: 0.25s, 0.25s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.tutorial-hint--visible {
    opacity: 1;
    translate: 0 0;
}

/* Reduce flash / motion: no fade, no slide. */
.tutorial-hint--no-motion {
    transition-duration: 0s, 0s;
    translate: 0 0;
}

.tutorial-hint-header {
    font-size: 14px;
    color: rgb(240, 178, 70);
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.tutorial-hint-title {
    font-size: 22px;
    color: rgb(255, 248, 235);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 4px;
}

.tutorial-hint-body {
    font-size: 18px;
    color: rgb(240, 230, 215);
    white-space: normal;
    margin-bottom: 10px;
}

.tutorial-hint-ok {
    align-self: flex-end;
    min-width: 140px;
    min-height: 48px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(34, 22, 12);
    background-color: rgb(240, 178, 70);
    border-radius: 10px;
    border-width: 0;
    margin: 0;
}

.tutorial-hint-ok:hover {
    background-color: rgb(250, 200, 100);
}

.tutorial-hint-ok:focus {
    border-width: 3px;
    border-color: rgb(255, 248, 235);
}

/* Static outline around the HUD element a hint talks about: never animated/blinking. */
.tutorial-highlight {
    position: absolute;
    display: none;
    border-width: 4px;
    border-color: rgb(240, 178, 70);
    border-radius: 12px;
    background-color: rgba(240, 178, 70, 0.12);
}
