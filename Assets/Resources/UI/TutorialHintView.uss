.tutorial-hint-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-start;
    /* Below the HUD top row (vitals / top-right buttons, ~100px) and the world map top bar, which
       grows to ~140px once a region is cleared ("Próximo: ..." + boss button): at 72px the hint
       covered the right half of that bar. Still clear of the screen centre where combat happens. */
    padding-top: 168px;
    padding-left: 16px;
    padding-right: 16px;
}

.tutorial-hint {
    width: 70%;
    max-width: 460px;
    padding: 8px 14px 8px 14px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    /* Fully opaque: at 0.95 the map's region labels showed through the bubble. */
    background-color: rgb(46, 27, 16);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--rap-gold);
    border-bottom-width: 4px;
    border-bottom-color: var(--rap-caramel);
    display: none;
    opacity: 0;
    translate: 0 -24px;
    transition-property: opacity, translate;
    transition-duration: 0.25s, 0.25s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.tutorial-hint--visible {
    opacity: 1;
    translate: 0 0;
}

/* Reduce flash / motion: no fade, no slide. */
.tutorial-hint--no-motion {
    transition-duration: 0s, 0s;
    translate: 0 0;
}

.tutorial-hint-header {
    font-size: 12px;
    color: rgb(60, 30, 8);
    background-color: var(--rap-gold);
    border-radius: 6px;
    padding: 1px 8px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.tutorial-hint-title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 17px;
    color: var(--rap-gold-light);
    -unity-font-style: bold;
    white-space: normal;
}

.tutorial-hint-body {
    width: 100%;
    font-size: 15px;
    color: var(--rap-cream);
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 6px;
}

/* Touch target stays >= 44px tall even in the compact bubble. */
/* Look from .rap-button / .rap-button--primary (RapaduraTheme.uss). */
.tutorial-hint-ok {
    margin-left: auto;
    min-width: 112px;
    height: auto;
    min-height: 44px;
    font-size: 16px;
    margin: 0;
}

/* Static outline around the HUD element a hint talks about: never animated/blinking. */
.tutorial-highlight {
    position: absolute;
    display: none;
    border-width: 4px;
    border-color: var(--rap-gold);
    border-radius: 12px;
    background-color: rgba(244, 196, 88, 0.12);
}
