.tutorial-hint-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: flex-start;
    /* Top strip, clear of the screen centre where combat happens (and of the HUD vitals row). */
    padding-top: 72px;
    padding-left: 16px;
    padding-right: 16px;
}

.tutorial-hint {
    width: 70%;
    max-width: 460px;
    padding: 8px 14px 8px 14px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    background-color: rgba(34, 22, 12, 0.95);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(240, 178, 70);
    display: none;
    opacity: 0;
    translate: 0 -24px;
    transition-property: opacity, translate;
    transition-duration: 0.25s, 0.25s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.tutorial-hint--visible {
    opacity: 1;
    translate: 0 0;
}

/* Reduce flash / motion: no fade, no slide. */
.tutorial-hint--no-motion {
    transition-duration: 0s, 0s;
    translate: 0 0;
}

.tutorial-hint-header {
    font-size: 12px;
    color: rgb(240, 178, 70);
    -unity-font-style: bold;
    margin-right: 8px;
}

.tutorial-hint-title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 17px;
    color: rgb(255, 248, 235);
    -unity-font-style: bold;
    white-space: normal;
}

.tutorial-hint-body {
    width: 100%;
    font-size: 15px;
    color: rgb(240, 230, 215);
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 6px;
}

/* Touch target stays >= 44px tall even in the compact bubble. */
.tutorial-hint-ok {
    margin-left: auto;
    min-width: 112px;
    min-height: 44px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(34, 22, 12);
    background-color: rgb(240, 178, 70);
    border-radius: 10px;
    border-width: 0;
    margin: 0;
}

.tutorial-hint-ok:hover {
    background-color: rgb(250, 200, 100);
}

.tutorial-hint-ok:focus {
    border-width: 3px;
    border-color: rgb(255, 248, 235);
}

/* Static outline around the HUD element a hint talks about: never animated/blinking. */
.tutorial-highlight {
    position: absolute;
    display: none;
    border-width: 4px;
    border-color: rgb(240, 178, 70);
    border-radius: 12px;
    background-color: rgba(240, 178, 70, 0.12);
}
