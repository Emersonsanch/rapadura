/* Ficha do personagem — Rapadura theme (Common/RapaduraTheme.uss, imported first in the UXML;
   rap-theme on the root gives the palette, rap-panel / rap-heading / rap-button the window, title
   and Fechar). Same brown-sugar window / gold accent language as QuestLogView.uss.
   Touch-first: every interactive element is at least 44px tall, the "+" buttons are 56px. */

.character-sheet-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(20, 10, 4, 0.86);
    display: none;
}

.character-sheet-window {
    width: 86%;
    min-width: 560px;
    max-width: 1100px;
    height: 86%;
    min-height: 380px;
    background-color: var(--rap-brown-deep);
    padding: 16px 20px;
}

.character-sheet-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.character-sheet-title {
    flex-grow: 1;
    font-size: 28px;
}

.character-sheet-close-button {
    min-width: 96px;
    height: 44px;
    margin: 0;
    font-size: 16px;
}

/* ---- Hero: name/class left, level + XP bar right ---- */
.character-sheet-hero {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    margin-bottom: 10px;
    background-color: var(--rap-brown);
    border-width: 1px;
    border-color: rgba(226, 158, 70, 0.5);
    border-radius: 10px;
}

.character-sheet-hero-names {
    flex-grow: 1;
    flex-shrink: 1;
}

.character-sheet-hero-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--rap-cream);
}

.character-sheet-hero-class {
    font-size: 14px;
    color: var(--rap-cream-dim);
}

.character-sheet-level-block {
    width: 40%;
    min-width: 200px;
    align-items: stretch;
}

.character-sheet-level {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--rap-gold);
    -unity-text-align: middle-right;
}

.character-sheet-xp-track {
    height: 12px;
    margin: 4px 0 2px 0;
    border-radius: 6px;
    background-color: var(--rap-brown-night);
    border-width: 1px;
    border-color: rgba(244, 196, 88, 0.35);
    overflow: hidden;
}

.character-sheet-xp-fill {
    height: 100%;
    width: 0;
    background-color: var(--rap-gold);
}

.character-sheet-xp-label {
    font-size: 12px;
    color: var(--rap-cream-dim);
    -unity-text-align: middle-right;
}

/* ---- Body: attributes | stats + equipment ---- */
.character-sheet-body {
    flex-grow: 1;
    flex-direction: row;
}

.character-sheet-column {
    flex-grow: 1;
    flex-basis: 0;
}

.character-sheet-column--attributes {
    flex-grow: 1.4;
    margin-right: 14px;
}

.character-sheet-section-header {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    margin: 2px 0 6px 0;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(244, 196, 88, 0.3);
}

.character-sheet-section-header--spaced {
    margin-top: 14px;
}

.character-sheet-points {
    font-size: 14px;
    color: var(--rap-cream-dim);
    white-space: normal;
    margin-bottom: 8px;
}

.character-sheet-points--available {
    color: rgb(196, 230, 140);
    -unity-font-style: bold;
}

.character-sheet-attribute-row {
    flex-direction: row;
    align-items: center;
    min-height: 64px;
    margin-bottom: 6px;
    padding: 4px 8px 4px 12px;
    background-color: rgba(86, 50, 26, 0.7);
    border-width: 1px;
    border-color: rgba(226, 158, 70, 0.35);
    border-left-width: 4px;
    border-left-color: rgba(226, 158, 70, 0.55);
    border-radius: 8px;
}

.character-sheet-attribute-row--primary {
    border-left-color: var(--rap-gold);
}

.character-sheet-attribute-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.character-sheet-attribute-name-line {
    flex-direction: row;
    align-items: center;
}

.character-sheet-attribute-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--rap-cream);
}

.character-sheet-attribute-primary-tag {
    font-size: 11px;
    -unity-font-style: bold;
    margin-left: 6px;
    padding: 1px 6px;
    border-radius: 8px;
    background-color: var(--rap-gold);
    color: rgb(60, 30, 8);
}

.character-sheet-attribute-preview {
    font-size: 13px;
    color: rgb(190, 222, 130);
    white-space: normal;
}

.character-sheet-attribute-value {
    min-width: 48px;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--rap-gold-light);
    -unity-text-align: middle-right;
    margin-right: 4px;
}

.character-sheet-attribute-talent {
    font-size: 12px;
    color: var(--rap-cream-dim);
    margin-right: 8px;
}

.character-sheet-spend-button {
    width: 56px;
    height: 56px;
    min-width: 56px;
    min-height: 56px;
    margin: 0;
    padding: 0;
    font-size: 28px;
    -unity-font-style: bold;
    border-radius: 28px;
    border-width: 2px;
    border-color: var(--rap-gold-light);
    border-bottom-color: rgb(110, 58, 16);
    background-color: var(--rap-caramel);
    color: rgb(255, 252, 240);
    text-shadow: 1px 1px 0px rgba(60, 26, 6, 0.8);
    -unity-text-align: middle-center;
}

.character-sheet-spend-button:hover {
    background-color: var(--rap-caramel-light);
}

.character-sheet-spend-button:focus {
    border-color: var(--rap-focus);
    background-color: var(--rap-gold);
    color: rgb(60, 30, 8);
}

.character-sheet-spend-button:disabled {
    border-color: rgba(150, 96, 48, 0.4);
    background-color: rgba(86, 50, 26, 0.4);
    color: rgba(255, 242, 216, 0.3);
}

.character-sheet-stat-row {
    flex-direction: row;
    align-items: center;
    min-height: 30px;
    padding: 2px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(244, 196, 88, 0.15);
}

.character-sheet-stat-name {
    flex-grow: 1;
    font-size: 14px;
    color: var(--rap-cream-dim);
}

.character-sheet-stat-value {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--rap-cream);
}

.character-sheet-equipment-row {
    font-size: 14px;
    color: var(--rap-cream);
    white-space: normal;
    margin-bottom: 4px;
    padding: 2px 8px;
}

.character-sheet-equipment-empty {
    font-size: 14px;
    color: var(--rap-cream-dim);
    white-space: normal;
    padding: 2px 8px;
}
