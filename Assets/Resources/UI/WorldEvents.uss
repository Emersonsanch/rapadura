/*
 * World bosses and Invasão do Cangaço (Docs/WorldEvents.md), built in code (no UXML):
 * - the world-map countdown pill and the "Enfrentar" / "Defender" buttons (WorldEventMapPanel, on the map HUD's document);
 * - the fight HUD (title, timer, boss bar, points, objective, banner) and the results card (WorldEventHud).
 * Loaded at runtime from Resources (WorldEventStyles), which also puts `rap-theme` on the layer.
 */

@import url("/Assets/UI/Common/RapaduraTheme.uss");

/* ---- World map: countdown pill (top centre, under the event-room pill) ---- */

.we-map-pill {
    position: absolute;
    top: 172px;
    left: 0;
    right: 0;
    align-items: center;
}

.we-map-card {
    background-color: rgba(30, 14, 30, 0.86);
    border-width: 2px;
    border-color: var(--rap-clay-red);
    border-radius: 12px;
    padding: 4px 12px;
    align-items: center;
    max-width: 680px;
}

.we-map-line {
    font-size: 15px;
    color: var(--rap-cream);
    white-space: normal;
    -unity-text-align: middle-center;
}

.we-map-line--open {
    color: var(--rap-gold-light);
    -unity-font-style: bold;
}

.we-map-message {
    font-size: 14px;
    color: var(--rap-cream-dim);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 560px;
}

.we-map-button {
    border-color: var(--rap-clay-red);
}

/* ---- Fight HUD ---- */

.we-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.we-hud {
    position: absolute;
    top: 16px;
    left: 0;
    right: 0;
    align-items: center;
}

.we-hud-card {
    background-color: rgba(30, 14, 30, 0.84);
    border-width: 2px;
    border-color: var(--rap-gold);
    border-radius: 14px;
    padding: 6px 18px;
    align-items: center;
    min-width: 300px;
}

.we-hud-title {
    font-size: 16px;
    color: var(--rap-gold-light);
    -unity-font-style: bold;
}

.we-hud-timer {
    font-size: 28px;
    color: var(--rap-cream);
    -unity-font-style: bold;
}

.we-hud-timer--low {
    color: var(--rap-clay-red);
}

.we-hud-bar {
    width: 280px;
    height: 12px;
    margin-top: 2px;
    margin-bottom: 2px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 6px;
    overflow: hidden;
}

.we-hud-fill {
    height: 100%;
    background-color: var(--rap-clay-red);
}

.we-hud-points {
    font-size: 17px;
    color: var(--rap-gold-light);
}

.we-hud-goal {
    font-size: 15px;
    color: var(--rap-cream-dim);
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 460px;
}

.we-banner {
    position: absolute;
    top: 180px;
    left: 0;
    right: 0;
    align-items: center;
}

.we-banner-text {
    background-color: rgba(30, 14, 30, 0.86);
    border-radius: 12px;
    padding: 6px 16px;
    font-size: 18px;
    color: var(--rap-cream);
    white-space: normal;
    max-width: 640px;
    -unity-text-align: middle-center;
}

/* ---- Results card ---- */

.we-results {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 5, 2, 0.45);
}

.we-results-card {
    background-color: var(--rap-panel-bg);
    border-width: 3px;
    border-color: var(--rap-panel-border);
    border-radius: 16px;
    padding: 16px 26px;
    align-items: center;
    min-width: 360px;
    max-width: 640px;
}

.we-results-title {
    font-size: 26px;
    color: var(--rap-gold-light);
    -unity-font-style: bold;
    margin-bottom: 6px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.we-results-tier {
    font-size: 22px;
    color: var(--rap-gold);
    -unity-font-style: bold;
}

.we-results-line {
    font-size: 16px;
    color: var(--rap-cream);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.we-results-quote {
    font-size: 16px;
    color: var(--rap-cream-dim);
    -unity-font-style: italic;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 10px;
}
